<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Style x:Key="ST.Text.Title" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource ST.Font.UI}"/>
  <Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{DynamicResource ST.Brush.Text}"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
 <Style x:Key="ST.Text.Caption" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource ST.Font.UI}"/>
  <Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/>
  <Setter Property="Foreground" Value="{DynamicResource ST.Brush.SecondaryText}"/>
 </Style>
 <Style x:Key="ST.Surface" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource ST.Brush.Surface}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource ST.Brush.Border}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="{StaticResource ST.Radius.Surface}"/>
  <Setter Property="Padding" Value="{StaticResource ST.Padding.Surface}"/>
 </Style>
 <Style x:Key="ST.Button" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
  <Setter Property="MinHeight" Value="{StaticResource ST.Control.Height}"/>
  <Setter Property="Padding" Value="12,5"/>
  <Setter Property="FontFamily" Value="{StaticResource ST.Font.UI}"/>
 </Style>
 <Style x:Key="ST.Editor" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
  <Setter Property="MinHeight" Value="{StaticResource ST.Control.Height}"/>
  <Setter Property="FontFamily" Value="{StaticResource ST.Font.UI}"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
  <Setter Property="AcceptsReturn" Value="True"/>
  <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
 </Style>
 <Style x:Key="ST.Splitter" TargetType="GridSplitter">
  <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/>
  <Setter Property="ResizeDirection" Value="Columns"/><Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
  <Setter Property="KeyboardIncrement" Value="16"/><Setter Property="DragIncrement" Value="1"/>
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridSplitter">
   <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
    <Border Width="2" Margin="0,8" Background="{DynamicResource ST.Brush.SecondaryText}"/>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ST.Brush.Hover}"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True">
    <Setter Property="BorderBrush" Value="{DynamicResource ST.Brush.AccentText}"/><Setter Property="BorderThickness" Value="2"/>
   </Trigger>
  </Style.Triggers>
 </Style>
</ResourceDictionary>
