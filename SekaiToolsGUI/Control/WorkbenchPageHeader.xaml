<UserControl x:Class="SekaiToolsGUI.Control.WorkbenchPageHeader"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Name="HeaderRoot">
 <StackPanel>
  <StackPanel Orientation="Horizontal">
   <ui:SymbolIcon Symbol="{Binding Icon, ElementName=HeaderRoot}" FontSize="24" Margin="0,0,12,0"
                  Foreground="{DynamicResource ST.Brush.Text}"/>
   <TextBlock Text="{Binding Title, ElementName=HeaderRoot}" Style="{StaticResource ST.Text.Title}"/>
  </StackPanel>
  <TextBlock Text="{Binding Description, ElementName=HeaderRoot}" Margin="0,8,0,0" Style="{StaticResource ST.Text.Caption}"/>
 </StackPanel>
</UserControl>
