<UserControl x:Class="SekaiToolsGUI.Control.WorkbenchPageHeader"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:SekaiToolsGUI.Control" x:Name="HeaderRoot">
 <StackPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ui:SymbolIcon Symbol="{Binding Icon, ElementName=HeaderRoot}" FontSize="24" Margin="0,0,12,0"
                  Foreground="{DynamicResource ST.Brush.Text}"/>
   <TextBlock Grid.Column="1" Text="{Binding Title, ElementName=HeaderRoot}" Style="{StaticResource ST.Text.Title}"
      AutomationProperties.AutomationId="Workbench.Header.Title"/>
  </Grid>
  <TextBlock Text="{Binding Description, ElementName=HeaderRoot}" Margin="0,8,0,0">
   <TextBlock.Style>
    <Style TargetType="TextBlock" BasedOn="{StaticResource ST.Text.Caption}">
     <Style.Triggers>
      <DataTrigger Binding="{Binding Description, ElementName=HeaderRoot}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      <Trigger Property="local:AdaptiveLayout.IsShort" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
     </Style.Triggers>
    </Style>
   </TextBlock.Style>
  </TextBlock>
 </StackPanel>
</UserControl>
