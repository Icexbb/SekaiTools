<UserControl x:Class="SekaiToolsGUI.Control.ExportOptionsControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:SekaiToolsGUI.Control"
             xmlns:settings="clr-namespace:SekaiToolsGUI.View.Setting.Components"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="ResetHost" TargetType="Border">
            <Setter Property="Visibility"
                    Value="{Binding ShowResetButtons, RelativeSource={RelativeSource AncestorType={x:Type local:ExportOptionsControl}}, Converter={StaticResource BooleanToVisibility}}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <ui:CardExpander Icon="{ui:SymbolIcon CommentNote24}" Margin="0,0,0,8" ContentPadding="0"
                     IsExpanded="{Binding IsExpanded, ElementName=Root, Mode=TwoWay}">
        <ui:CardExpander.Header>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="输出注释" VerticalAlignment="Center" />
                    <Border Style="{StaticResource ResetHost}">
                        <settings:SettingResetButton
                            Properties="ExportLine1,ExportLine2,ExportLine3,ExportCharacter,ExportUnchangedCharacter,ExportBannerMask,ExportBannerText,ExportMarkerMask,ExportMarkerText,ExportScreenComment"
                            AutomationProperties.Name="还原输出注释默认设置" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Description, ElementName=Root}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:CardExpander.Header>
        <StackPanel>
            <ui:CardControl Icon="{ui:SymbolIcon TextDescription24}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="对话" VerticalAlignment="Center" />
                        <Border Style="{StaticResource ResetHost}">
                            <settings:SettingResetButton Properties="ExportLine1,ExportLine2,ExportLine3"
                                                         AutomationProperties.Name="还原对话默认设置" />
                        </Border>
                    </StackPanel>
                </ui:CardControl.Header>
                <WrapPanel HorizontalAlignment="Right" MaxWidth="220">
                    <CheckBox Content="一行" IsChecked="{Binding ExportLine1, Mode=TwoWay}" />
                    <CheckBox Content="二行" IsChecked="{Binding ExportLine2, Mode=TwoWay}" />
                    <CheckBox Content="三行" IsChecked="{Binding ExportLine3, Mode=TwoWay}" />
                </WrapPanel>
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon Person24}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="说话人" VerticalAlignment="Center" />
                        <Border Style="{StaticResource ResetHost}">
                            <settings:SettingResetButton Properties="ExportCharacter,ExportUnchangedCharacter"
                                                         AutomationProperties.Name="还原说话人默认设置" />
                        </Border>
                    </StackPanel>
                </ui:CardControl.Header>
                <WrapPanel Orientation="Horizontal">
                    <CheckBox Content="与原文不同" IsChecked="{Binding ExportCharacter, Mode=TwoWay}" />
                    <CheckBox Content="与原文相同" IsChecked="{Binding ExportUnchangedCharacter, Mode=TwoWay}" />
                </WrapPanel>
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon Location24}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="横幅" VerticalAlignment="Center" />
                        <Border Style="{StaticResource ResetHost}">
                            <settings:SettingResetButton Properties="ExportBannerMask,ExportBannerText"
                                                         AutomationProperties.Name="还原横幅默认设置" />
                        </Border>
                    </StackPanel>
                </ui:CardControl.Header>
                <WrapPanel HorizontalAlignment="Right" MaxWidth="220">
                    <CheckBox Content="遮罩" IsChecked="{Binding ExportBannerMask, Mode=TwoWay}" />
                    <CheckBox Content="内容" IsChecked="{Binding ExportBannerText, Mode=TwoWay}" />
                </WrapPanel>
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon Bookmark24}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="地点角标" VerticalAlignment="Center" />
                        <Border Style="{StaticResource ResetHost}">
                            <settings:SettingResetButton Properties="ExportMarkerMask,ExportMarkerText"
                                                         AutomationProperties.Name="还原地点角标默认设置" />
                        </Border>
                    </StackPanel>
                </ui:CardControl.Header>
                <WrapPanel HorizontalAlignment="Right" MaxWidth="220">
                    <CheckBox Content="遮罩" IsChecked="{Binding ExportMarkerMask, Mode=TwoWay}" />
                    <CheckBox Content="内容" IsChecked="{Binding ExportMarkerText, Mode=TwoWay}" />
                </WrapPanel>
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon Comment24}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="其他注释" VerticalAlignment="Center" />
                        <Border Style="{StaticResource ResetHost}">
                            <settings:SettingResetButton Properties="ExportScreenComment"
                                                         AutomationProperties.Name="还原其他注释默认设置" />
                        </Border>
                    </StackPanel>
                </ui:CardControl.Header>
                <CheckBox Content="注释" IsChecked="{Binding ExportScreenComment, Mode=TwoWay}" />
            </ui:CardControl>
        </StackPanel>
    </ui:CardExpander>
</UserControl>