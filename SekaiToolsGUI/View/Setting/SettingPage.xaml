<UserControl x:Class="SekaiToolsGUI.View.Setting.SettingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:configuration="clr-namespace:SekaiToolsConfiguration;assembly=SekaiToolsConfiguration"

             xmlns:setting="clr-namespace:SekaiToolsGUI.ViewModel.Setting"

             d:DataContext="{d:DesignInstance setting:SettingPageModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0">
            <StackPanel x:Name="SettingsItems" Margin="10">

                <ui:CardExpander x:Name="LogSection" Margin="0,0,0,8" Icon="{ui:SymbolIcon ClipboardTask24}" ContentPadding="0">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="运行日志" />
                            <ui:TextBlock Grid.Row="1" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                          Text="查看程序运行过程中产生的日志" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="8">
                            <ui:Button DockPanel.Dock="Right" Content="清空日志" Click="ClearLog_Click" />
                            <ui:Button x:Name="TestErrorButton"
                                       DockPanel.Dock="Right"
                                       Margin="0,0,8,0"
                                       Content="测试错误提示"
                                       Visibility="Collapsed"
                                       Click="TestErrorButton_Click" />

                            <ui:TextBlock Text="等级:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="LevelFilter" Width="100" SelectedIndex="0"
                                      SelectionChanged="LevelFilter_SelectionChanged">
                                <ComboBoxItem>全部</ComboBoxItem>
                                <ComboBoxItem>INFO+</ComboBoxItem>
                                <ComboBoxItem>WARN+</ComboBoxItem>
                                <ComboBoxItem>ERROR+</ComboBoxItem>
                            </ComboBox>
                        </DockPanel>
                        <ListBox x:Name="LogListBox" Grid.Row="1"
                                 MaxHeight="400"
                                 Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                 BorderThickness="0"
                                 FontFamily="Consolas" FontSize="11"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </ui:CardExpander>

                <ui:CardExpander x:Name="AboutSection" ContentPadding="0"
                                 Icon="{ui:ImageIcon 'pack://application:,,,/Resource/icon.png', Width=28, Height=28}">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                FontTypography="Body"
                                Text="Sekai Tools" />
                            <ui:TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="© 2024 PJS字幕组 | Icexbb 以 AGPL-3.0 协议开源" />

                            <ui:TextBlock
                                Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding AppVersion, Mode=OneWay}" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <ui:Anchor
                            Margin="0"
                            Padding="16"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0"
                            NavigateUri="{x:Static configuration:NetworkEndpoints.RepositoryUrl}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="代码仓库" />
                                <ui:SymbolIcon Grid.Column="1" Symbol="Link24" />
                            </Grid>
                        </ui:Anchor>
                    </StackPanel>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>
        <ui:Card Grid.Row="1" Padding="5">
            <Grid>
                <ui:Button
                    Margin="10"
                    HorizontalAlignment="Left"
                    Width="100"
                    Content="重置为默认"
                    Click="ResetToDefault_Click" />
                <ui:TextBlock
                    Margin="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    Text="更改会自动保存" />
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>