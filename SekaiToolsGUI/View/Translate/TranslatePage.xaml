<UserControl x:Class="SekaiToolsGUI.View.Translate.TranslatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:SekaiToolsGUI.View.Translate.Components"
             xmlns:translate="clr-namespace:SekaiToolsGUI.ViewModel.Translate"
             xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800" d:Background="White"
             d:DataContext="{d:DesignInstance translate:TranslatePageModel, IsDesignTimeCreatable=True}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:Card Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                 Padding="14,10" VerticalContentAlignment="Center"
                 HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Margin="0,0,0,8" FontSize="12" Opacity="0.65" Text="在线载入" />
                    <ui:Button Content="前往数据下载" Click="OpenDownloadPageButton_OnClick" />
                </StackPanel> 
                <StackPanel Grid.Column="1">
                    <TextBlock Margin="0,0,0,8" FontSize="12" Opacity="0.65" Text="本地载入" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Click="LoadFileButton_OnClick"
                                   Name="LoadScriptButton" Content="载入剧本" />
                        <ui:Button Margin="0,0,8,0" Click="LoadTranslationButton_OnClick"
                                   IsEnabled="{c:Binding Path='Events.Length!=0'}"
                                   Content="载入翻译文件" />
                        <ui:Button Name="ReferenceTranslationButton" Click="LoadReviewButton_OnClick"
                                   IsEnabled="{c:Binding Path='Events.Length!=0'}"
                                   Content="载入参考翻译文件" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Margin="0,0,0,8" FontSize="12" Opacity="0.65" Text="任务控制" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Click="ResetButton_OnClick" Name="ResetButton"
                                   Content="重置" IsEnabled="{c:Binding Path='Events.Length!=0'}" />
                        <ui:Button Click="SaveButton_OnClick" Name="SaveButton" Content="保存"
                                   Appearance="Primary" IsEnabled="{c:Binding Path='Events.Length!=0'}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

        </ui:Card>
        <components:TranslateFastCopy Grid.Row="1" Grid.Column="0" Width="160" />
        <!-- <ui:Card Grid.Column="1" Margin="5,0,0,0"  -->
        <!--          Grid.Row="1" Name="TranslateContainer" -->
        <!--          VerticalContentAlignment="Top" VerticalAlignment="Stretch" Padding="2"> -->
        <!--     <ui:PassiveScrollViewer Padding="0" -->
        <!--         VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" -->
        <!--         MaxHeight="{Binding ElementName=TranslateContainer, Path=ActualHeight}"> -->
        <!--         <StackPanel Orientation="Vertical" Name="TranslatePanel" Margin="5,5,5,15"  /> -->
        <!--     </ui:PassiveScrollViewer> -->
        <!-- </ui:Card> -->

        <ListView Grid.Column="1" Grid.Row="1" ItemsSource="{c:Binding Events }"
                  BorderBrush="Transparent"
                  Background="Transparent"
                  ScrollViewer.CanContentScroll="True"
                  Name="TranslatePanel"
                  VirtualizingStackPanel.ScrollUnit="Pixel">
            <ListView.Resources>
                <DataTemplate DataType="{x:Type translate:LineDialogModel}">
                    <components:TranslateLineDialog LineDialogModel="{Binding }" HorizontalAlignment="Stretch" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type translate:LineEffectModel}">
                    <components:TranslateLineEffect LineEffectModel="{Binding }" HorizontalAlignment="Stretch" />
                </DataTemplate>
            </ListView.Resources>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <!-- 禁用焦点和悬浮效果 -->
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>