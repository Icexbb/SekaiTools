<UserControl x:Class="SekaiToolsGUI.View.Translate.TranslatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:SekaiToolsGUI.View.Translate.Components"
             xmlns:translate="clr-namespace:SekaiToolsGUI.ViewModel.Translate"
             xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
             xmlns:control="clr-namespace:SekaiToolsGUI.Control"
             mc:Ignorable="d"
             AllowDrop="True" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             PreviewDragOver="Page_OnPreviewDragOver" PreviewDrop="Page_OnPreviewDrop"
             PreviewDragLeave="Page_OnPreviewDragLeave" Unloaded="Page_OnUnloaded"
             d:DesignHeight="960" d:DesignWidth="1280" d:Background="White"
             d:DataContext="{d:DesignInstance translate:TranslatePageModel, IsDesignTimeCreatable=True}">
    <Grid>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Card Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                     Padding="15,10,15,5" VerticalContentAlignment="Center"
                     HorizontalAlignment="Stretch">
                <StackPanel>
                    <WrapPanel>
                        <ui:Button Content="前往数据下载" Click="OpenDownloadPageButton_OnClick" Margin="0,0,8,8" />
                        <ui:Button x:Name="LoadScriptButton" Content="载入剧本" Click="LoadFileButton_OnClick" Margin="0,0,8,8" />
                        <ui:Button x:Name="LoadTranslationButton" Content="载入翻译文件" Click="LoadTranslationButton_OnClick" Margin="0,0,8,8"
                                   Visibility="{c:Binding HasScript,FalseToVisibility=Collapsed}" />
                        <ui:Button x:Name="ReferenceTranslationButton" Content="载入参考翻译文件" Click="LoadReviewButton_OnClick" Margin="0,0,8,8"
                                   Visibility="{c:Binding HasScript,FalseToVisibility=Collapsed}" />
                        <control:Popover x:Name="SpecialCharPopover" Padding="0" StaysOpen="False" Margin="0,0,8,8"
                                         Visibility="{c:Binding HasScript,FalseToVisibility=Collapsed}">
                            <control:Popover.Target><ui:Button Click="SpecialCharButton_OnClick" Content="复制特殊字符" /></control:Popover.Target>
                            <control:Popover.Content><components:TranslateFastCopy Width="240" MaxHeight="420" CustomCharacterAdding="SpecialCharacters_OnCustomCharacterAdding" /></control:Popover.Content>
                        </control:Popover>
                        <ui:Button Margin="0,0,8,8" Click="UndoButton_OnClick" IsEnabled="{Binding CanUndo}" ToolTip="撤销 (Ctrl+Z)" AutomationProperties.Name="撤销">
                            <ui:SymbolIcon Symbol="ArrowUndo24" />
                        </ui:Button>
                        <ui:Button Margin="0,0,8,8" Click="RedoButton_OnClick" IsEnabled="{Binding CanRedo}" ToolTip="重做 (Ctrl+Y / Ctrl+Shift+Z)" AutomationProperties.Name="重做">
                            <ui:SymbolIcon Symbol="ArrowRedo24" />
                        </ui:Button>
                        <ui:Button x:Name="ResetButton" Content="清除…" Click="OpenClearMenu_OnClick" IsEnabled="{Binding HasScript}" Margin="0,0,8,8">
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="清除当前译文（保留剧本和参考）" Click="ClearTranslation_OnClick" />
                                    <MenuItem Header="移除参考翻译" Click="ClearReference_OnClick" IsEnabled="{Binding HasReferenceTranslation}" />
                                    <Separator />
                                    <MenuItem Header="清除整个工作区" Click="ResetButton_OnClick" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                        <ui:Button x:Name="SaveButton" Content="保存" Icon="{ui:SymbolIcon Save24}" Click="SaveButton_OnClick" Appearance="Primary" IsEnabled="{c:Binding 'Events.Length!=0'}" Margin="0,0,8,8" />
                        <ui:Button Content="另存为…" Icon="{ui:SymbolIcon SaveCopy24}" Click="SaveAsButton_OnClick" ToolTip="另存为 (Ctrl+Shift+S)"
                                   IsEnabled="{c:Binding 'Events.Length!=0'}" Margin="0,0,8,8" />
                        <ui:Button Content="打开保存位置" Icon="{ui:SymbolIcon FolderOpen24}" Click="OpenSavedLocation_OnClick" Margin="0,0,8,8"
                                   Visibility="{c:Binding HasTranslation,FalseToVisibility=Collapsed}" />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="剧本：" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TextBlockScriptFile" MaxWidth="250" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                        <TextBlock Text="翻译：" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TextBlockTranslation" MaxWidth="250" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                        <TextBlock Text="参考：" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TextBlockTranslationReference" MaxWidth="250" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="4,0,4,8">
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Document24" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding SaveStatus}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Visibility="{c:Binding HasScript,FalseToVisibility=Collapsed}">
                <WrapPanel Margin="0,0,0,8">
                    <ui:SymbolIcon Symbol="Search24" Margin="4,0,8,0" />
                    <ui:TextBox x:Name="SearchBox" Width="240" Margin="0,0,8,0" PlaceholderText="搜索原文、译文、角色或编号"
                                AutomationProperties.Name="搜索翻译条目"
                                Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Width="130" Margin="0,0,8,0" SelectedIndex="{Binding FilterIndex}" AutomationProperties.Name="条目筛选">
                        <ComboBoxItem Content="全部条目" />
                        <ComboBoxItem Content="仅看未译" />
                        <ComboBoxItem Content="仅看有提示" />
                        <ComboBoxItem Content="仅看闪回" />
                    </ComboBox>
                    <ui:Button Content="刷新筛选" Icon="{ui:SymbolIcon ArrowSync24}" Click="RefreshFilter_OnClick" Margin="0,0,8,0"
                               ToolTip="输入过程中保留当前条目，点击后按最新状态重新筛选。" />
                    <ui:Button Content="下一未译" Icon="{ui:SymbolIcon ArrowRight28}" Click="NextUntranslated_OnClick" Margin="0,0,8,0" ToolTip="下一未译 (Ctrl+Enter)" />
                    <ui:Button Content="下一提示" Icon="{ui:SymbolIcon Warning28}" Click="NextWarning_OnClick" Margin="0,0,8,0" />
                    <CheckBox Content="显示参考译文" IsChecked="{Binding ShowReference}" VerticalAlignment="Center" />
                    <CheckBox Content="同步相同场景文字" IsChecked="{Binding SyncMatchingContent}" Margin="12,0,0,0" VerticalAlignment="Center"
                              ToolTip="项目级开关：后续编辑会同步整个剧本中原文相同的场景文字；开启时不会立即覆盖现有译文。" />
                    <CheckBox Content="同步相同说话人译名" IsChecked="{Binding SyncMatchingSpeakers}" Margin="12,0,0,0" VerticalAlignment="Center"
                              ToolTip="项目级开关：后续修改说话人译名时，同步整个剧本中原名相同的说话人，不修改对话正文。" />
                    <CheckBox Content="自动规范标点和用词" IsChecked="{Binding AutoFormat}" VerticalAlignment="Center" Margin="12,0,0,0"
                              ToolTip="离开编辑框后规范标点和用词（如半角标点转全角、欸转诶）。关闭可保留输入写法。" />
                </WrapPanel>
                <WrapPanel Margin="4,0,4,8">
                    <TextBlock Text="{Binding ProgressText}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding VisibleCountText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </WrapPanel>
                <TextBlock Text="{Binding LastEditFeedback}" Margin="4,0,4,8" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Border x:Name="ImportErrorPanel" Visibility="Collapsed" Padding="8" Margin="0,0,0,8"
                        BorderThickness="1" BorderBrush="{DynamicResource SystemFillColorCriticalBrush}">
                    <StackPanel>
                        <TextBlock Text="文件未载入，当前编辑内容已保留" FontWeight="SemiBold" />
                        <TextBlock x:Name="ImportErrorText" TextWrapping="Wrap" Margin="0,4" />
                        <WrapPanel>
                            <ui:Button Content="复制错误详情" Icon="{ui:SymbolIcon Copy24}" Click="CopyImportError_OnClick" Margin="0,0,8,0" />
                            <ui:Button Content="关闭提示" Click="DismissImportError_OnClick" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="24"
                        VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{c:Binding !HasScript, FalseToVisibility=Collapsed}">
                <ui:SymbolIcon Symbol="Document24" FontSize="40"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="点击按钮或拖入载入剧本" FontSize="20" Margin="0,16,0,8"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="支持 JSON / asset 剧本和 TXT 翻译。先载入剧本，再载入当前译文或仅供对照的参考译文。"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <ListView Grid.Column="1" Grid.Row="3" ItemsSource="{Binding VisibleEvents}"
                      BorderBrush="Transparent"
                      Background="Transparent"
                      ScrollViewer.CanContentScroll="True"
                      Name="TranslatePanel"
                      PreviewMouseDown="TranslatePanel_OnActivity" GotKeyboardFocus="TranslatePanel_OnActivity"
                      LostKeyboardFocus="TranslatePanel_OnLostFocus"
                      VirtualizingStackPanel.ScrollUnit="Pixel">
                <ListView.Resources>
                    <DataTemplate DataType="{x:Type translate:LineDialogModel}">
                        <DockPanel LastChildFill="True">
                            <components:TranslateLineActions DockPanel.Dock="Left" />
                            <StackPanel>
                                <components:TranslateLineDialog
                                    LineDialogModel="{Binding }" HorizontalAlignment="Stretch" />
                                <components:TranslateLineSeparator
                                    Visibility="{c:Binding EndLine,FalseToVisibility=Collapsed}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type translate:LineEffectModel}">
                        <DockPanel LastChildFill="True">
                            <components:TranslateLineActions DockPanel.Dock="Left" />
                            <components:TranslateLineEffect LineEffectModel="{Binding}" HorizontalAlignment="Stretch" />
                        </DockPanel>
                    </DataTemplate>
                </ListView.Resources>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <!-- 禁用焦点和悬浮效果 -->
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="IsHitTestVisible" Value="True" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="没有符合条件的条目，请更改搜索或筛选条件。"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"
                       Visibility="{c:Binding 'HasScript and VisibleEvents.Length==0',FalseToVisibility=Collapsed}" />
        </Grid>
        <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
              Background="#B0000000">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="DropErrorRegion" Grid.RowSpan="2" Visibility="Collapsed"
                    Margin="12" Padding="24" CornerRadius="8" BorderBrush="#FFFF8080"
                    BorderThickness="2" Background="#A0601010">
                <StackPanel VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="DocumentDismiss24" Foreground="White" FontSize="32" />
                    <TextBlock Text="无法载入翻译文件" Foreground="White" FontSize="24"
                               Margin="0,12,0,12" TextAlignment="Center" />
                    <TextBlock x:Name="DropErrorText" Foreground="White" FontSize="16"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>
            <Border x:Name="ReferenceDropRegion" Margin="12,12,12,6" CornerRadius="8"
                    BorderBrush="White" BorderThickness="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Document24" Foreground="White" FontSize="32" />
                    <TextBlock x:Name="ReferenceDropText" Text="松开以载入参考翻译" Foreground="White"
                               FontSize="24" Margin="0,12,0,0" TextAlignment="Center" />
                </StackPanel>
            </Border>
            <Border x:Name="TranslationDropRegion" Grid.Row="1" Margin="12,6,12,12" CornerRadius="8"
                    BorderBrush="White" BorderThickness="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Document24" Foreground="White" FontSize="32" />
                    <TextBlock Text="松开以载入翻译" Foreground="White" FontSize="24"
                               Margin="0,12,0,0" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
