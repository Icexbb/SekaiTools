<UserControl x:Class="SekaiToolsGUI.View.Translate.Components.TranslateLineActions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
             xmlns:components="clr-namespace:SekaiToolsGUI.View.Translate.Components"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Border VerticalAlignment="Stretch" Padding="3,5" BorderBrush="{DynamicResource ST.Brush.Border}" BorderThickness="0,0,1,0">
        <StackPanel Margin="2" Width="52" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding SequenceNumber, StringFormat='#{0}'}" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" ToolTip="{Binding Label}" />
            <Grid Margin="0,3,0,0" HorizontalAlignment="Center"
                  Visibility="{c:Binding HasVoice,FalseToVisibility=Collapsed}">
                <ui:Button Padding="5" Width="34" Height="34" IsEnabled="{Binding VoicePlaybackAvailable}"
                           Click="PlayVoice" Visibility="{c:Binding HasVoice,FalseToVisibility=Collapsed}"
                           ToolTip="{Binding VoiceState}"
                           ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="原始角色语音预览">
                    <ui:SymbolIcon>
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Play24" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VoicePlaying}" Value="True">
                                        <Setter Property="Symbol" Value="Pause24" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VoiceLoading}" Value="True">
                                        <Setter Property="Symbol" Value="ArrowClockwise24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </ui:Button>
                <components:VoiceProgressBorder Progress="{Binding VoiceProgress}" IsHitTestVisible="False"
                                                Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Grid>
            <TextBlock Text="加载中…" FontSize="10" HorizontalAlignment="Center"
                       Visibility="{c:Binding VoiceLoading,FalseToVisibility=Collapsed}" />
            <ui:Button Icon="{ui:SymbolIcon MoreHorizontal24}" Padding="4,2" Width="32" Height="28" Margin="0,4,0,0"
                       Appearance="Transparent" HorizontalAlignment="Center" Click="OpenActions" ToolTip="条目操作"
                       AutomationProperties.AutomationId="{Binding SequenceNumber, StringFormat=Translation.Row.{0}.Actions}"
                       AutomationProperties.Name="{Binding Label, StringFormat={}{0} 条目操作}">
                <ui:Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="查看上下文（显示全部条目）" Tag="context" Click="ApplyAction" />
                        <MenuItem Header="采用参考译文（仅此条正文）" Tag="reference" Click="ApplyAction"
                                  IsEnabled="{Binding Body.ReferenceAvailable}" />
                        <MenuItem Header="标为未译（导出沿用原文）" Tag="untranslated" Click="ApplyAction" />
                        <MenuItem Header="有意留空（导出空白）" Tag="blank" Click="ApplyAction" />
                        <MenuItem Header="使用原文" Tag="original" Click="ApplyAction" />
                    </ContextMenu>
                </ui:Button.ContextMenu>
            </ui:Button>
        </StackPanel>
    </Border>
</UserControl>
