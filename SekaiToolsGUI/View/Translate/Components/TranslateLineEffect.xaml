<UserControl x:Class="SekaiToolsGUI.View.Translate.Components.TranslateLineEffect"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
             xmlns:translate="clr-namespace:SekaiToolsGUI.ViewModel.Translate"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance translate:LineEffectModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="800"
             HorizontalAlignment="Stretch">
    <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:Card Grid.Column="0" Margin="0" Padding="0">
            <ui:SymbolIcon Symbol="Location28" Margin="5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
        </ui:Card>
        <ui:Card Grid.Column="1" Margin="0" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Padding="5,2"
                           Background="Transparent"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Center"
                           TextWrapping="Wrap" Text="{Binding Path= Content.Original}" />
                <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight28" Margin="5" />
                <StackPanel Grid.Column="2">
                    <StackPanel Visibility="{c:Binding 'Content.ReferenceAvailable and ShowReference',FalseToVisibility=Collapsed}">
                        <TextBlock Text="参考译文" Margin="4,2" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox IsReadOnly="True" IsTabStop="False" Text="{Binding Content.Reference}" TextWrapping="Wrap"
                                 Background="Transparent" BorderBrush="Transparent" AutomationProperties.Name="场景文字参考译文" />
                    </StackPanel>
                    <TextBlock Text="我的译文" Margin="4,2" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Padding="5,2" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Label}"
                                Text="{Binding Content.Translated,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>