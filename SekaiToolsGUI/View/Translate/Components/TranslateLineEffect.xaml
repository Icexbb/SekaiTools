<UserControl x:Class="SekaiToolsGUI.View.Translate.Components.TranslateLineEffect"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
             xmlns:components="clr-namespace:SekaiToolsGUI.View.Translate.Components"
             xmlns:translate="clr-namespace:SekaiToolsGUI.ViewModel.Translate"
             xmlns:behaviors="clr-namespace:SekaiToolsGUI.Behaviors"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance translate:LineEffectModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="800"
             HorizontalAlignment="Stretch">
    <Grid MinHeight="75" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding DataContext.ListRoleWidth, RelativeSource={RelativeSource AncestorType=ListView}, FallbackValue=150}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <components:TranslateLineActions Grid.Column="0" />
        <ui:Card Grid.Column="1" Margin="0" Padding="0" VerticalAlignment="Stretch">
            <ui:SymbolIcon Symbol="Location28" Margin="5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
        </ui:Card>
        <ui:Card Grid.Column="2" Margin="0" Padding="2,0" VerticalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="{Binding DataContext.ListTextFontSize, RelativeSource={RelativeSource AncestorType=ListView}, FallbackValue=14}" Grid.Column="0"
                           Padding="10,2"
                           Background="Transparent"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Center"
                           TextWrapping="Wrap" Text="{Binding Path= Content.Original}" />
                <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight28" Margin="5" />
                <Grid Grid.Column="2" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                          Visibility="{c:Binding 'Content.ReferenceAvailable and ShowReference',FalseToVisibility=Collapsed}">
                        <TextBox FontSize="{Binding DataContext.ListTextFontSize, RelativeSource={RelativeSource AncestorType=ListView}, FallbackValue=14}" IsReadOnly="True" IsTabStop="False" TextWrapping="NoWrap" MinLines="1" MaxLines="1"
                                 TextAlignment="Center" VerticalScrollBarVisibility="Hidden"
                                 Padding="10,2"
                                 HorizontalScrollBarVisibility="Disabled" Background="Transparent"
                                 BorderBrush="Transparent"
                                 behaviors:TextDifferenceHighlight.Comparison="{Binding Content.Translated}"
                                 behaviors:TextDifferenceHighlight.IsEnabled="{c:Binding 'Content.ReferenceAvailable and ShowReference'}"
                                 ToolTip="{Binding Content.Reference}"
                                 AutomationProperties.Name="参考译文" Text="{Binding Content.Reference}" />
                        <TextBlock Text="参考译文" FontSize="10" Opacity="0.5" Margin="4,0,6,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Grid Grid.Row="1" Visibility="{c:Binding Content.HasLoadedChanges,FalseToVisibility=Collapsed}">
                        <TextBox FontSize="{Binding DataContext.ListTextFontSize, RelativeSource={RelativeSource AncestorType=ListView}, FallbackValue=14}" IsReadOnly="True" IsTabStop="False" TextWrapping="NoWrap" MinLines="1" MaxLines="1"
                                 TextAlignment="Center" VerticalScrollBarVisibility="Hidden" Padding="10,2"
                                 HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderBrush="Transparent"
                                 behaviors:TextDifferenceHighlight.LoadedComparison="{Binding Content.Translated}"
                                 behaviors:TextDifferenceHighlight.IsLoadedComparisonEnabled="{Binding Content.HasLoadedChanges}"
                                 ToolTip="{Binding Content.LoadedText}"
                                 AutomationProperties.Name="载入时译文" Text="{Binding Content.LoadedText}" />
                        <TextBlock Text="载入时译文" FontSize="10" Opacity="0.5" Margin="4,0,6,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ui:TextBox FontSize="{Binding DataContext.ListTextFontSize, RelativeSource={RelativeSource AncestorType=ListView}, FallbackValue=14}" Grid.Row="2" Padding="10,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                TextAlignment="Center"
                                AutomationProperties.Name="{Binding Label}"
                                ToolTip="蓝色框：载入后修改；黄色框：参考差异。"
                                behaviors:TextDifferenceHighlight.LoadedComparison="{Binding Content.LoadedText}"
                                behaviors:TextDifferenceHighlight.Comparison="{Binding Content.Reference}"
                                behaviors:TextDifferenceHighlight.IsEnabled="{c:Binding 'Content.ReferenceAvailable and ShowReference'}"
                                Text="{Binding Content.Translated,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>