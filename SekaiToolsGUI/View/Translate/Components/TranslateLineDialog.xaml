<UserControl x:Class="SekaiToolsGUI.View.Translate.Components.TranslateLineDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c='clr-namespace:CalcBinding;assembly=CalcBinding'
             xmlns:translate="clr-namespace:SekaiToolsGUI.ViewModel.Translate"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance translate:LineDialogModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="800"
             HorizontalAlignment="Stretch">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:Card Grid.Column="0" Margin="0" Padding="5,2" VerticalAlignment="Stretch">
            <Grid VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ui:ImageIcon
                        Visibility="{c:Binding 'Icon.Length>0',FalseToVisibility=Collapsed}"
                        Source="{Binding Path= Icon}"
                        Width="28" Height="28" />
                    <ui:SymbolIcon Symbol="Comment28"
                                   Visibility="{c:Binding 'Icon.Length==0',FalseToVisibility=Collapsed}" />
                    <ui:SymbolIcon x:Name="ShakeIndicator" Symbol="PhoneShake24" Margin="0,6,0,0"
                                   ToolTip="抖动行" AutomationProperties.Name="抖动行"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{c:Binding Shake,FalseToVisibility=Collapsed}" />
                </StackPanel>
                <Grid Grid.Column="2" Margin="0" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Padding="0"
                               VerticalAlignment="Top" HorizontalAlignment="Center"
                               Text="{Binding Path= Character.Original}"
                               ToolTipService.ToolTip="{Binding Path= Character.Original}"
                               ToolTipService.InitialShowDelay="0"
                               ToolTipService.BetweenShowDelay="0" />
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:SymbolIcon Grid.Row="1" Symbol="ArrowDown28" />
                    </Grid>
                    <ui:TextBox Grid.Row="2"
                                Padding="0"
                                KeyboardNavigation.TabNavigation="Continue"
                                BorderBrush="Transparent"
                                Background="Transparent"
                                AcceptsReturn="False"
                                ClearButtonEnabled="False"
                                VerticalAlignment="Bottom"
                                HorizontalContentAlignment="Center"
                                HorizontalAlignment="Stretch"
                                PlaceholderEnabled="True"
                                PlaceholderText="{Binding Path= Character.Original}"
                                TextAlignment="Center"
                                AutomationProperties.Name="角色名译名"
                                Text="{Binding Path= Character.Translated, UpdateSourceTrigger=PropertyChanged}"
                                TextChanged="NameEditBoxChanged" />
                </Grid>
            </Grid>
        </ui:Card>
        <ui:Card Grid.Column="1" Margin="0" Padding="5,2" VerticalAlignment="Stretch">
            <Grid VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <TextBox Grid.Row="0" Name="OriginalContentTextBox"
                         KeyboardNavigation.TabNavigation="Continue"
                         MinLines="2"
                         Margin="0"
                         IsTabStop="False"
                         TextWrapping="NoWrap"
                         VerticalAlignment="Stretch"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="False"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="原文"
                         Text="{Binding Content.Original}" />
                    <Border x:Name="FlashbackBadge" Grid.Row="1" Padding="6,4" Margin="2,4,2,2" CornerRadius="4"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            ToolTip="{Binding FlashbackHint}"
                            Visibility="{c:Binding IsFlashback,FalseToVisibility=Collapsed}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="History24" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding FlashbackLabel}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <ui:SymbolIcon Grid.Row="0" Grid.RowSpan="3" Symbol="ArrowRight28" Margin="5" />
                    <ui:SymbolIcon Grid.Row="2" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Symbol="Warning28" ToolTip="{Binding Check}">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Check.Length,Mode=OneWay}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </Grid>
                <StackPanel Grid.Column="2" VerticalAlignment="Stretch">
                    <StackPanel Visibility="{c:Binding 'Content.Reference.Length>0', FalseToVisibility=Collapsed}">
                        <TextBlock Text="参考译文" Margin="4,2" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox IsReadOnly="True" IsTabStop="False" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderBrush="Transparent"
                                 AutomationProperties.Name="参考译文" Text="{Binding Content.Reference}" />
                    </StackPanel>
                    <TextBlock Text="我的译文" Margin="4,2" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox MinLines="2" HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Auto"
                             PreviewKeyDown="TextBox_PreviewKeyDown" PreviewTextInput="TextBox_PreviewTextInput"
                             AcceptsReturn="True" TextWrapping="NoWrap" AutomationProperties.Name="{Binding Label}"
                             Text="{Binding Content.Translated,UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="4,2" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="最长行加权长度：" /><Run Text="{Binding MaxLineLength,Mode=OneWay}" />
                        <Run Text="；全文字符数：" /><Run Text="{Binding Content.Translated.Length,Mode=OneWay}" />
                    </TextBlock>
                    <Border Margin="2,4" Padding="6" CornerRadius="4"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            Visibility="{c:Binding 'Check.Length>0',FalseToVisibility=Collapsed}">
                        <DockPanel>
                            <ui:SymbolIcon Symbol="Warning28" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="{Binding Check}" TextWrapping="Wrap"
                                       AutomationProperties.Name="校验提示"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
