<UserControl x:Class="SekaiToolsGUI.View.Translate.Components.TranslateLineDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c='clr-namespace:CalcBinding;assembly=CalcBinding'
             xmlns:components="clr-namespace:SekaiToolsGUI.View.Translate.Components"
             xmlns:translate="clr-namespace:SekaiToolsGUI.ViewModel.Translate"
             xmlns:settings="clr-namespace:SekaiToolsGUI.ViewModel.Setting"
             xmlns:behaviors="clr-namespace:SekaiToolsGUI.Behaviors"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance translate:LineDialogModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="800"
             HorizontalAlignment="Stretch">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding DataContext.ListRoleWidth, RelativeSource={RelativeSource AncestorType=ListView}, FallbackValue=150}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <components:TranslateLineActions Grid.Column="0" />
        <ui:Card Grid.Column="1" Margin="0" Padding="10,2" VerticalAlignment="Stretch">
            <Grid VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ui:ImageIcon
                        Visibility="{c:Binding 'Icon.Length>0',FalseToVisibility=Collapsed}"
                        Source="{Binding Path= Icon}"
                        Width="28" Height="28" />
                    <ui:SymbolIcon Symbol="Comment28"
                                   Visibility="{c:Binding 'Icon.Length==0',FalseToVisibility=Collapsed}" />
                    <ui:SymbolIcon x:Name="ShakeIndicator" Symbol="PhoneShake24" Margin="0,6,0,0"
                                   ToolTip="抖动行" AutomationProperties.Name="抖动行"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{c:Binding Shake,FalseToVisibility=Collapsed}" />
                </StackPanel>
                <Grid Grid.Column="2" Margin="0" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="{Binding DataContext.ListTextFontSize, RelativeSource={RelativeSource AncestorType=ListView}, FallbackValue=14}" Grid.Row="0" Padding="0"
                               VerticalAlignment="Top" HorizontalAlignment="Center"
                               Text="{Binding Path= Character.Original}"
                               TextWrapping="Wrap"
                               ToolTipService.ToolTip="{Binding Path= Character.Original}"
                               ToolTipService.InitialShowDelay="0"
                               ToolTipService.BetweenShowDelay="0" />
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:SymbolIcon Grid.Row="1" Symbol="ArrowDown28" />
                    </Grid>
                    <ui:TextBox FontSize="{Binding DataContext.ListTextFontSize, RelativeSource={RelativeSource AncestorType=ListView}, FallbackValue=14}" Grid.Row="2"
                                Padding="0"
                                KeyboardNavigation.TabNavigation="Continue"
                                BorderBrush="Transparent"
                                Background="Transparent"
                                AcceptsReturn="False"
                                ClearButtonEnabled="False"
                                VerticalAlignment="Bottom"
                                HorizontalContentAlignment="Center"
                                HorizontalAlignment="Stretch"
                                PlaceholderEnabled="True"
                                PlaceholderText="{Binding Path= Character.Original}"
                                TextAlignment="Center"
                                AutomationProperties.Name="角色名译名"
                                behaviors:TextDifferenceHighlight.LoadedComparison="{Binding Character.LoadedText}"
                                ToolTip="{Binding SyncHint}"
                                Text="{Binding Path= Character.Translated, UpdateSourceTrigger=PropertyChanged}"
                                TextChanged="NameEditBoxChanged" />
                </Grid>
            </Grid>
        </ui:Card>
        <ui:Card Grid.Column="2" Margin="0" Padding="10,2" VerticalAlignment="Stretch">
            <Grid VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox FontSize="{Binding DataContext.ListTextFontSize, RelativeSource={RelativeSource AncestorType=ListView}, FallbackValue=14}" Grid.Row="0" Name="OriginalContentTextBox"
                             KeyboardNavigation.TabNavigation="Continue"
                             MinLines="2"
                             Margin="0"
                             IsTabStop="False"
                             TextWrapping="Wrap"
                             VerticalAlignment="Stretch"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             Background="Transparent"
                             BorderBrush="Transparent"
                             HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="原文"
                             Text="{Binding Content.Original}" />
                    <Border x:Name="FlashbackBadge" Grid.Row="1" Padding="6,4" Margin="2,4,2,2" CornerRadius="4"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            ToolTip="{Binding FlashbackHint}"
                            Visibility="{c:Binding IsFlashback,FalseToVisibility=Collapsed}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="History24" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding FlashbackLabel}" FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <ui:SymbolIcon Grid.Row="0" Grid.RowSpan="3" Symbol="ArrowRight28" Margin="5" />
                    <ui:SymbolIcon Grid.Row="2" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Symbol="Warning28" ToolTip="{Binding Check}">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Check.Length,Mode=OneWay}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </Grid>
                <Grid Grid.Column="2" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                        Visibility="{c:Binding 'Content.ReferenceAvailable and ShowReference',FalseToVisibility=Collapsed}">
                        <TextBox FontSize="{Binding DataContext.ListTextFontSize, RelativeSource={RelativeSource AncestorType=ListView}, FallbackValue=14}" IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap" Padding="10,2"
                                 HorizontalScrollBarVisibility="Disabled" Background="Transparent"
                                 BorderBrush="Transparent"
                                 behaviors:TextDifferenceHighlight.Comparison="{Binding Content.Translated}"
                                 behaviors:TextDifferenceHighlight.IsEnabled="{c:Binding 'Content.ReferenceAvailable and ShowReference'}"
                                 ToolTip="{Binding Content.Reference}"
                                 AutomationProperties.Name="参考译文" Text="{Binding Content.Reference}" />
                        <TextBlock Text="参考译文" FontSize="10" Opacity="0.5" Margin="4,0,6,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Grid Grid.Row="1" Visibility="{c:Binding Content.HasLoadedChanges,FalseToVisibility=Collapsed}">
                        <TextBox FontSize="{Binding DataContext.ListTextFontSize, RelativeSource={RelativeSource AncestorType=ListView}, FallbackValue=14}" IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap" Padding="10,2"
                                 HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderBrush="Transparent"
                                 behaviors:TextDifferenceHighlight.LoadedComparison="{Binding Content.Translated}"
                                 behaviors:TextDifferenceHighlight.IsLoadedComparisonEnabled="{Binding Content.HasLoadedChanges}"
                                 ToolTip="{Binding Content.LoadedText}"
                                 AutomationProperties.Name="载入时译文" Text="{Binding Content.LoadedText}" />
                        <TextBlock Text="载入时译文" FontSize="10" Opacity="0.5" Margin="4,0,6,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <TextBox FontSize="{Binding DataContext.ListTextFontSize, RelativeSource={RelativeSource AncestorType=ListView}, FallbackValue=14}" Grid.Row="2" VerticalAlignment="Stretch" behaviors:NewlineMarker.Style="{Binding TranslationNewlineMarker, Source={x:Static settings:SettingPageModel.Instance}}"
                             MinLines="2" Padding="10,2" HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="TextBox_PreviewKeyDown" PreviewTextInput="TextBox_PreviewTextInput"
                             DataObject.Pasting="TextBox_OnPasting" GotKeyboardFocus="TextBox_OnGotKeyboardFocus"
                             LostKeyboardFocus="TextBox_OnLostKeyboardFocus"
                             ToolTip="蓝色框表示相对载入译文的修改；黄色框表示参考差异。显示自动折行不改变正文中的换行。Enter 插入正文换行；Ctrl+Enter 跳到下一未译。"
                             AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="{Binding Label}"
                             behaviors:TextDifferenceHighlight.LoadedComparison="{Binding Content.LoadedText}"
                             behaviors:TextDifferenceHighlight.Comparison="{Binding Content.Reference}"
                             behaviors:TextDifferenceHighlight.IsEnabled="{c:Binding 'Content.ReferenceAvailable and ShowReference'}"
                             Text="{Binding Content.Translated,UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="3" Margin="4,2" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="最长行加权长度：" /><Run Text="{Binding MaxLineLength,Mode=OneWay,StringFormat={}{0:0.##}}" />
                        <Run Text="；全文字符数：" /><Run Text="{Binding Content.Translated.Length,Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Row="4" Text="{Binding InputHint}" TextWrapping="Wrap" Margin="4,2"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Visibility="{c:Binding 'InputHint.Length>0',FalseToVisibility=Collapsed}" />
                    <Border Grid.Row="5" Margin="2,4" Padding="6" CornerRadius="4"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            Visibility="{c:Binding 'Check.Length>0',FalseToVisibility=Collapsed}">
                        <DockPanel>
                            <ui:SymbolIcon Symbol="Warning28" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="{Binding Check}" TextWrapping="Wrap"
                                       AutomationProperties.Name="校验提示"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>