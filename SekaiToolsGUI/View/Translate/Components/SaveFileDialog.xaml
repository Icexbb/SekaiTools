<ui:ContentDialog
    x:Class="SekaiToolsGUI.View.Translate.Components.SaveFileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:layout="clr-namespace:SekaiToolsGUI.Control"
    layout:AdaptiveLayout.FitDialog="True"
    xmlns:components="clr-namespace:SekaiToolsGUI.View.Translate.Components"
    xmlns:subtitle="clr-namespace:SekaiToolsGUI.ViewModel.Subtitle"
    mc:Ignorable="d"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    d:DataContext="{d:DesignInstance subtitle:SaveFileDialogModel, IsDesignTimeCreatable=True}"
    IsPrimaryButtonEnabled="True" IsSecondaryButtonEnabled="True"
    Title="保存选项" DefaultButton="Primary"
    DialogWidth="500" Width="500"
    PrimaryButtonText="保存" SecondaryButtonText="浏览" CloseButtonText="取消">
    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
               TargetType="{x:Type components:SaveFileDialog}" />
    </ui:ContentDialog.Resources>
    <ui:ContentDialog.Content>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ui:SymbolIcon Symbol="Document24" Margin="0,0,8,0" />
                <TextBlock Text="导出格式" VerticalAlignment="Center" />
            </StackPanel>
            <ComboBox x:Name="FormatSelector" SelectedIndex="0" Margin="0,0,0,12">
                <ComboBoxItem Content="TXT v2（按剧本标识匹配，推荐）" />
                <ComboBoxItem Content="旧 TXT（按行顺序匹配）" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ui:SymbolIcon Symbol="Tag24" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="文件名标签" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ui:Button Content="翻译" Tag="翻译" Click="TranslationTag_OnClick" Margin="0,0,6,0"
                           AutomationProperties.Name="使用翻译文件名标签" />
                <ui:Button Content="校对" Tag="校对" Click="TranslationTag_OnClick" Margin="0,0,6,0"
                           AutomationProperties.Name="使用校对文件名标签" />
                <ui:Button Content="合意" Tag="合意" Click="TranslationTag_OnClick"
                           AutomationProperties.Name="使用合意文件名标签" />
            </StackPanel>
            <TextBlock Text="文件将保存到：" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBox IsReadOnly="True" Margin="5,15,5,5"
                     Text="{Binding Path=FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </ui:ContentDialog.Content>
</ui:ContentDialog>
