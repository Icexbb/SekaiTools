<UserControl x:Class="SekaiToolsGUI.View.Suppress.SuppressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
             xmlns:converter="clr-namespace:SekaiToolsGUI.Converter"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:suppress="clr-namespace:SekaiToolsGUI.ViewModel.Suppress"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance suppress:SuppressPageModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="600" d:DesignWidth="800" d:Background="White">
    <UserControl.Resources>
        <converter:BoolToAppearanceConverter x:Key="RunningToAppearance"
                                             TrueToAppearance="Danger"
                                             FalseToAppearance="Secondary" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,5,0,0">
            <ui:CardControl Height="70" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Video24}"
                            Margin="0,0,0,5" HorizontalAlignment="Stretch">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="视频文件" />
                        <ui:TextBlock Grid.Row="1" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{Binding SourceVideo}"
                                      ToolTip="{Binding SourceVideo}"
                                      TextTrimming="CharacterEllipsis"
                                      Visibility="{c:Binding 'SourceVideo.Length!=0', FalseToVisibility=Collapsed}" />
                    </Grid>
                </ui:CardControl.Header>
                <ui:Button HorizontalAlignment="Right"
                           IsEnabled="{Binding HasNotStarted ,Mode=OneWay}"
                           Content="浏览" Click="VideoFileBrowser_OnClick" />

            </ui:CardControl>

            <ui:CardControl Height="70" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Subtitles24}"
                            Margin="0,0,0,5" HorizontalAlignment="Stretch"
                            Visibility="{c:Binding 'SourceVideo.Length != 0', FalseToVisibility=Collapsed}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="字幕文件（可选）" />
                        <ui:TextBlock Grid.Row="1" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{Binding SourceSubtitle}"
                                      ToolTip="{Binding SourceSubtitle}"
                                      TextTrimming="CharacterEllipsis"
                                      Visibility="{c:Binding 'SourceSubtitle.Length!=0', FalseToVisibility=Collapsed}" />
                        <ui:TextBlock Grid.Row="1" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="未选择时仅转码"
                                      Visibility="{c:Binding 'SourceSubtitle.Length==0', FalseToVisibility=Collapsed}" />
                    </Grid>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Margin="0,0,8,0" Content="清除"
                               IsEnabled="{Binding HasNotStarted}"
                               Visibility="{c:Binding 'SourceSubtitle.Length!=0', FalseToVisibility=Collapsed}"
                               Click="ClearSubtitle_OnClick" />
                    <ui:Button IsEnabled="{Binding HasNotStarted}"
                               Content="浏览" Click="ScriptFileBrowser_OnClick" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Height="70" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon StreamOutput20}"
                            Margin="0,0,0,5" HorizontalAlignment="Stretch"
                            Visibility="{c:Binding 'SourceVideo.Length!=0', FalseToVisibility=Collapsed}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="输出路径" />
                        <ui:TextBlock Grid.Row="1" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{Binding OutputPath}"
                                      ToolTip="{Binding OutputPath}"
                                      TextTrimming="CharacterEllipsis"
                                      Visibility="{c:Binding 'OutputPath.Length!=0', FalseToVisibility=Collapsed}" />
                    </Grid>
                </ui:CardControl.Header>
                <ui:Button HorizontalAlignment="Right"
                           IsEnabled="{Binding HasNotStarted}"
                           Content="浏览" Click="SaveFileBrowser_OnClick" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon TabInPrivate24}"
                            Visibility="{c:Binding 'HasNotStarted', FalseToVisibility=Collapsed}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="固定码率因子" />
                        <ui:TextBlock Grid.Row="1" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="压制时使用的Crf" />
                    </Grid>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Path=SuppressCrf}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider Width="100" Minimum="0" Maximum="51" IsSnapToTickEnabled="True"
                            Value="{Binding Path=SuppressCrf, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon AppsAddIn24}"
                            Visibility="{c:Binding 'HasNotStarted', FalseToVisibility=Collapsed}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="使用最佳参数" />
                        <ui:TextBlock Grid.Row="1" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="压制速度较慢" />
                    </Grid>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding UseComplexConfig}" />
            </ui:CardControl>
        </StackPanel>
        <ui:Card Grid.Row="1" Padding="5" Margin="0,10"
                 VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid VerticalAlignment="Stretch">
                <Grid Margin="10" Visibility="{c:Binding !HasNotStarted,FalseToVisibility=Collapsed}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold"
                                  Text="{Binding Status}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Margin="0,6,0,10"
                                  Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                  Text="{Binding ProgressDescription}" />
                    <Expander Grid.Row="2" Header="详细日志" VerticalAlignment="Stretch">
                        <ui:TextBox IsReadOnlyCaretVisible="False" MinHeight="100"
                                    VerticalAlignment="Stretch" IsReadOnly="True" TextWrapping="Wrap"
                                    Text="{Binding DetailLog}"
                                    TextChanged="StatusTextChange_OnTextChanged" />
                    </Expander>
                </Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{c:Binding HasNotStarted,FalseToVisibility=Collapsed}">
                    <ui:ProgressRing Margin="0,0,0,8" IsIndeterminate="True"
                                     Visibility="{c:Binding IsPreparingResources,FalseToVisibility=Collapsed}" />
                    <ui:Button HorizontalAlignment="Center" Content="开始压制"
                               Click="StartSuppress_OnClick"
                               IsEnabled="{Binding CanStartSuppress}" />
                    <ui:TextBlock Margin="0,8,0,0" HorizontalAlignment="Center"
                                  Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                  Text="{Binding ConfigError}"
                                  Visibility="{c:Binding 'ConfigError.Length != 0', FalseToVisibility=Collapsed}" />
                </StackPanel>
            </Grid>

        </ui:Card>

        <ui:Card Grid.Row="2" Padding="5" VerticalAlignment="Stretch">
            <StackPanel>
                <ProgressBar Value="{Binding Progression}"
                             Maximum="1" Minimum="0" Margin="10"
                             Visibility="{c:Binding !HasNotStarted,FalseToVisibility=Collapsed}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{c:Binding !HasNotStarted,FalseToVisibility=Collapsed}">
                    <ui:Button Name="DisposeButton" Margin="10" Click="DisposeButton_OnClick"
                               Content="{Binding TaskControlText}"
                               IsEnabled="{Binding CanControlTask}"
                               Appearance="{Binding Running, Converter={StaticResource RunningToAppearance}}" />
                    <ui:Button Name="ClearButton" Margin="10" Click="ClearButton_OnClick"
                               Content="清空任务" IsEnabled="{Binding CanClearTask}" />
                    <ui:Button Name="ShowFileButton" Margin="10" Click="ShowFileButton_OnClick"
                               Visibility="{c:Binding ShowResult, FalseToVisibility=Collapsed}">
                        显示结果
                    </ui:Button>
                </StackPanel>
            </StackPanel>
        </ui:Card>
    </Grid>
</UserControl>
