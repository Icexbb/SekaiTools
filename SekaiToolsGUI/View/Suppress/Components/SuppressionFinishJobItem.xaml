<UserControl x:Class="SekaiToolsGUI.View.Suppress.Components.SuppressionFinishJobItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:media="clr-namespace:SekaiToolsMedia;assembly=SekaiToolsMedia"
             xmlns:suppress="clr-namespace:SekaiToolsGUI.ViewModel.Suppress"
             mc:Ignorable="d" d:DesignWidth="500"
             d:DataContext="{d:DesignInstance suppress:SuppressionJobModel, IsDesignTimeCreatable=True}">
    <ui:Card Margin="0,0,10,6">
        <ui:Card.Style>
            <Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="LightGreen" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Progress.State}"
                                 Value="{x:Static media:VideoSuppressionState.Cancelled}">
                        <Setter Property="BorderBrush" Value="LightGray" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Progress.State}"
                                 Value="{x:Static media:VideoSuppressionState.Failed}">
                        <Setter Property="BorderBrush" Value="LightPink" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ui:Card.Style>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SourceVideo}" />
                    <TextBlock Text="{Binding OutputPath}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                               ToolTip="{Binding OutputPath}"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding EncodingDescription}" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Progress.Fraction, StringFormat={}{0:P1}}"
                                   Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Progress.FramesPerSecond, StringFormat={}{0:F1} FPS}"
                                   Margin="0,0,12,0" VerticalAlignment="Center" />
                    </StackPanel>

                </StackPanel>
                <Grid Grid.Column="1" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Progress.Status}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="显示结果" Click="ShowFileButton_OnClick"
                                   IsEnabled="{Binding IsCompleted}" />
                        <ui:Button Content="移除" Click="RemoveButton_OnClick" Margin="10,0,0,0" />
                        <ui:Button Content="显示日志" Click="ShowLogButton_OnClick" Margin="10,0,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
            <StackPanel Name="StackPanelLog" Visibility="Visible">
                <Separator Margin="0,3,0,3" />
                <TextBox Height="150" Text="{Binding Progress.Log, Mode=OneWay}" IsReadOnly="True"
                         FontSize="12" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </StackPanel>
        </StackPanel>
    </ui:Card>
</UserControl>