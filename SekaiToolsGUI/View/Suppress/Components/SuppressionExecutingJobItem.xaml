<UserControl x:Class="SekaiToolsGUI.View.Suppress.Components.SuppressionExecutingJobItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:suppress="clr-namespace:SekaiToolsGUI.ViewModel.Suppress"
             mc:Ignorable="d" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance suppress:SuppressionJobModel, IsDesignTimeCreatable=True}">
    <StackPanel>
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="100" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SourceVideo}" />
                    <TextBlock Text="{Binding OutputPath}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding OutputPath}"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Progress.Status}" FontWeight="SemiBold" />
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding EncodingDescription}" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0" Value="{Binding Progress.Fraction, Mode=OneWay}" Maximum="1"
                             IsIndeterminate="{Binding IsPreparing, Mode=OneWay}" Height="6" Margin="0,6" />
                <Grid Grid.Row="1" Margin="0,4,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBlock Text="{Binding Progress.Fraction, StringFormat={}{0:P1}}" Margin="0,0,12,0" />
                        <ui:TextBlock Text="{Binding Progress.FramesPerSecond, StringFormat={}{0:F1} FPS}" />
                    </StackPanel>
                    <ui:Button Content="取消" HorizontalAlignment="Right" Click="CancelJob_OnClick"
                               IsEnabled="{Binding CanCancel, Mode=OneWay}" />
                </Grid>
            </Grid>
                <TextBox x:Name="LogTextBox" Grid.Row="3" Text="{Binding Progress.Log, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Loaded="LogTextBox_OnLoaded" TextChanged="LogTextBox_OnTextChanged" />
        </Grid>
    </StackPanel>
</UserControl>
