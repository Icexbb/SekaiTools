<UserControl x:Class="SekaiToolsGUI.View.Suppress.Components.SuppressionQueueJobItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
             xmlns:suppress="clr-namespace:SekaiToolsGUI.ViewModel.Suppress"
             mc:Ignorable="d" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance suppress:SuppressionJobModel, IsDesignTimeCreatable=True}">
    <ui:Card x:Name="Control" Padding="10" Margin="0,0,10,6"
             PreviewMouseLeftButtonDown="Control_OnPreviewMouseLeftButtonDown"
             PreviewMouseMove="Control_OnPreviewMouseMove">
        <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SourceVideo}" />
                        <TextBlock Text="{Binding OutputPath}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding OutputPath}"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="等待中" FontWeight="SemiBold" />
                </Grid>
                <TextBlock Text="{Binding EncodingDescription}" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" Text="等待执行" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="开始执行" Click="StartExecuteButton_OnClick"
                                   Visibility="{c:Binding CanStart, FalseToVisibility=Collapsed}" />
                        <ui:Button Content="取消" Click="CancelJob_OnClick"
                                   IsEnabled="{Binding CanCancel}" Margin="10,0,0,0" />
                    </StackPanel>
                </Grid>
        </StackPanel>
    </ui:Card>
</UserControl>
