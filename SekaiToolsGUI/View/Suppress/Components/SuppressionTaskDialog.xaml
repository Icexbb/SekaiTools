<ui:ContentDialog x:Class="SekaiToolsGUI.View.Suppress.Components.SuppressionTaskDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:components="clr-namespace:SekaiToolsGUI.View.Suppress.Components"
                  xmlns:suppress="clr-namespace:SekaiToolsGUI.ViewModel.Suppress"
                  mc:Ignorable="d"
                  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  d:DataContext="{d:DesignInstance suppress:SuppressTaskSettingsModel, IsDesignTimeCreatable=True}"
                  IsPrimaryButtonEnabled="{Binding CanSubmit}"
                  Title="创建压制任务" DefaultButton="Primary"
                  PrimaryButtonText="创建任务" CloseButtonText="取消" MinWidth="680">
    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
               TargetType="{x:Type components:SuppressionTaskDialog}" />
    </ui:ContentDialog.Resources>
    <ui:ContentDialog.Content>
        <StackPanel>
            <TextBlock Text="填写参数后加入队列，任务将按顺序自动处理。" Margin="0,0,0,12" TextWrapping="Wrap" />
            <components:SuppressTaskSettings x:Name="TaskSettings" />
            <TextBlock Text="{Binding SubmissionError}"
                       TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextAlignment="Center" HorizontalAlignment="Stretch" />
            <CheckBox Content="添加后自动开始执行任务" Name="CheckBoxAutoStart"
                      HorizontalAlignment="Center" />
        </StackPanel>
    </ui:ContentDialog.Content>
</ui:ContentDialog>
