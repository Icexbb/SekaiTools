<ui:FluentWindow x:Class="SekaiToolsGUI.View.General.ErrorDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="错误"
                 Width="860"
                 Height="640"
                 MinWidth="680"
                 MinHeight="500"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="错误">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resource/icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1"
                      Padding="32,24,32,16"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44"
                            Height="44"
                            Margin="0,0,16,0"
                            VerticalAlignment="Top"
                            Background="#20C42B1C"
                            BorderBrush="#C42B1C"
                            BorderThickness="1"
                            CornerRadius="22">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#C42B1C"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Text="!" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="Sekai Tools 遇到了问题" />
                        <TextBlock x:Name="SummaryText"
                                   Margin="0,8,0,0"
                                   FontSize="15"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,0,0,8"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Text="建议处理方式" />
                <Border Margin="0,0,0,20"
                        Padding="16"
                        Background="#14C42B1C"
                        BorderBrush="#60C42B1C"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock x:Name="SuggestionText"
                               Foreground="#E5484D"
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap" />
                </Border>

                <Expander x:Name="DetailsExpander" Header="详细信息">
                    <TextBox x:Name="DetailsTextBox"
                             Margin="0,10,0,0"
                             MinHeight="220"
                             Padding="12"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="20,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="CopyButton"
                               Margin="0,0,8,0"
                               Click="CopyButton_OnClick"
                               Content="复制错误报告"
                               Icon="{ui:SymbolIcon Copy24}" />
                    <ui:Button Click="OpenIssueButton_OnClick"
                               Content="创建 GitHub Issue"
                               Icon="{ui:SymbolIcon Open24}" />
                </StackPanel>
                <ui:Button Grid.Column="1"
                           Click="CloseButton_OnClick"
                           Content="关闭" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
