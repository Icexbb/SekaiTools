<UserControl x:Class="SekaiToolsGUI.View.Subtitle.SubtitlePage"
             AutomationProperties.AutomationId="Subtitle.Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
             xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.WPF.DragDrop"
             xmlns:components="clr-namespace:SekaiToolsGUI.View.Subtitle.Components">
    <UserControl.Resources>
        <DataTemplate x:Key="TaskItemTemplate">
            <components:SubtitleQueueTaskItem Selected="TaskItem_OnSelected"
                                              RemoveRequested="TaskItem_OnRemoveRequested" />
        </DataTemplate>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>
        <Style x:Key="TaskPaneSplitter" TargetType="GridSplitter" BasedOn="{StaticResource ST.Splitter}">
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="Grip" Width="3" Height="32" CornerRadius="1.5"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{DynamicResource ST.Brush.Border}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource ST.Brush.SecondaryText}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource ST.Brush.AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="220" MaxWidth="350" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>
        <ui:Card Grid.Column="0" Padding="10"
                 VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:SymbolIcon Symbol="Video32" Margin="0,0,8,0" />
                    <TextBlock Text="字幕任务" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <ui:PassiveScrollViewer Grid.Row="1" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="暂无任务，请点击下方“添加”按钮创建任务。" Margin="0,12,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{c:Binding 'Queue.PendingTasks.Count + Queue.ProcessingTasks.Count + Queue.FinishedTasks.Count + Queue.HistoryTasks.Count == 0', FalseToVisibility=Collapsed}" />
                        <TextBlock Style="{StaticResource SectionHeader}" Text="未开始任务 · 可拖动排序"
                                   Visibility="{c:Binding 'Queue.PendingTasks.Count > 0', FalseToVisibility=Collapsed}" />
                        <ItemsControl x:Name="PendingTasksList" ItemsSource="{Binding Queue.PendingTasks}"
                                      ItemTemplate="{StaticResource TaskItemTemplate}" AllowDrop="True"
                                      dd:DragDrop.IsDropTarget="True" dd:DragDrop.ShowAlwaysDropTargetAdorner="True" />
                        <TextBlock Style="{StaticResource SectionHeader}" Text="正在进行任务"
                                   Visibility="{c:Binding 'Queue.ProcessingTasks.Count > 0', FalseToVisibility=Collapsed}" />
                        <ItemsControl ItemsSource="{Binding Queue.ProcessingTasks}"
                                      ItemTemplate="{StaticResource TaskItemTemplate}" />
                        <TextBlock Style="{StaticResource SectionHeader}" Text="已完成任务"
                                   Visibility="{c:Binding 'Queue.FinishedTasks.Count > 0', FalseToVisibility=Collapsed}" />
                        <ItemsControl ItemsSource="{Binding Queue.FinishedTasks}"
                                      ItemTemplate="{StaticResource TaskItemTemplate}" />
                        <TextBlock Style="{StaticResource SectionHeader}" Text="历史任务"
                                   Visibility="{c:Binding 'Queue.HistoryTasks.Count > 0', FalseToVisibility=Collapsed}" />
                        <ItemsControl ItemsSource="{Binding Queue.HistoryTasks}"
                                      ItemTemplate="{StaticResource TaskItemTemplate}" />
                    </StackPanel>
                </ui:PassiveScrollViewer>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" Click="AddButton_OnClick" Appearance="Primary" AutomationProperties.AutomationId="Subtitle.AddTaskButton"
                               IsEnabled="{Binding CanOpenDialog}" HorizontalAlignment="Stretch" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" Margin="0,0,5,0" />
                            <TextBlock Text="添加" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Grid.Column="1" Click="HistoryButton_OnClick" IsEnabled="{Binding CanOpenDialog}" AutomationProperties.AutomationId="Subtitle.HistoryButton"
                               HorizontalAlignment="Stretch" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" Margin="0,0,5,0" />
                            <TextBlock Text="历史" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Grid>
        </ui:Card>
        <GridSplitter Grid.Column="1" Style="{StaticResource TaskPaneSplitter}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      AutomationProperties.AutomationId="Subtitle.TaskPaneSplitter"
                      AutomationProperties.Name="调整字幕任务栏宽度" />
        <Grid Grid.Column="2">
            <TextBlock Text="添加任务，或从左侧选择任务查看处理结果"
                       VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{c:Binding !HasSelection, FalseToVisibility=Collapsed}" />
            <ContentControl Content="{Binding SelectedControl}" HorizontalContentAlignment="Stretch" Padding="0"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</UserControl>
