<UserControl x:Class="SekaiToolsGUI.View.Subtitle.Components.SubtitleQueueTaskItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
             xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.WPF.DragDrop">
    <UserControl.Resources>
        <DataTemplate x:Key="TaskDragPreview">
            <ui:Card Padding="10" MinWidth="220" Opacity="0.88">
                <StackPanel>
                    <TextBlock Text="{Binding VideoName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Status}" Margin="0,5,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:Card>
        </DataTemplate>
    </UserControl.Resources>
    <Border x:Name="TaskBorder" Padding="10" Margin="0,0,6,6" CornerRadius="8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorNeutralBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderThickness" Value="3" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State.IsRunning}" Value="True">
                        <Setter Property="BorderBrush" Value="DodgerBlue" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State.IsFinished}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State.IsCanceled}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State.IsFailed}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State.IsPartial}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,6,0" Cursor="SizeNS" ToolTip="拖动调整队列顺序"
                  Visibility="{c:Binding CanReorder, FalseToVisibility=Collapsed}"
                  dd:DragDrop.IsDragSource="{Binding CanReorder}" dd:DragDrop.UseDefaultDragAdorner="True"
                  dd:DragDrop.DragAdornerTemplate="{StaticResource TaskDragPreview}"
                  dd:DragDrop.UseVisualSourceItemSizeForDragAdorner="True">
                <ui:SymbolIcon Symbol="LineHorizontal320" VerticalAlignment="Center" />
            </Grid>
            <ui:Button Grid.Column="1" Click="SelectButton_OnClick" Padding="0" Appearance="Transparent"
                       BorderThickness="0"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                       AutomationProperties.Name="{Binding VideoName}">
                <StackPanel>
                    <TextBlock Text="{Binding VideoName}" TextTrimming="CharacterEllipsis"
                               FontWeight="SemiBold" ToolTip="{Binding State.VideoFilePath}" />
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding State.Progress, StringFormat={}{0:P0}}"
                                   Margin="5,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{c:Binding State.IsRunning, FalseToVisibility=Collapsed}" />
                    </Grid>
                    <ProgressBar Height="4" Margin="0,6,0,0" Maximum="1" Value="{Binding State.Progress}"
                                 Visibility="{c:Binding State.IsRunning, FalseToVisibility=Collapsed}" />
                </StackPanel>
            </ui:Button>
            <ui:Button Grid.Column="2" Click="RemoveButton_OnClick" Appearance="Transparent" Padding="3"
                       Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="移除任务"
                       AutomationProperties.Name="移除任务" IsEnabled="{c:Binding !State.IsRunning}">
                <ui:SymbolIcon Symbol="Dismiss24" />
            </ui:Button>
        </Grid>
    </Border>
</UserControl>
