<UserControl x:Class="SekaiToolsGUI.View.Subtitle.Components.SubtitleTaskProcess"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:calcBinding="clr-namespace:CalcBinding;assembly=CalcBinding"
             xmlns:subtitle="clr-namespace:SekaiToolsGUI.ViewModel.Subtitle"
             xmlns:components="clr-namespace:SekaiToolsGUI.View.Subtitle.Components"
             xmlns:layout="clr-namespace:SekaiToolsGUI.Control"
             mc:Ignorable="d"
             d:DesignWidth="800"
             SizeChanged="SubtitleTaskProcess_OnSizeChanged"
             PreviewKeyDown="SubtitleTaskProcess_OnPreviewKeyDown"
             d:DataContext="{d:DesignInstance subtitle:SubtitlePageModel, IsDesignTimeCreatable=True}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--任务控制-->
        <Grid x:Name="TaskHeaderGrid" Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="350" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--任务状态-->
            <Grid x:Name="TaskStatusPanel" Grid.Column="0" MinWidth="350" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 素材列表始终保持三行，预览缩放时只改变可用宽度。 -->
                <ui:Card Grid.Row="0" Padding="0" VerticalAlignment="Top">
                    <Grid Name="TaskMaterialsGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <ui:Button Grid.Row="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                   Padding="10,0" BorderThickness="0" Background="Transparent" Click="VideoFileBtn_OnClick"
                                   ToolTip="{Binding VideoFilePath}" AutomationProperties.Name="定位视频文件">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Video24" FontSize="18" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="视频" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding VideoFileName}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:SymbolIcon Grid.Column="3" Symbol="FolderOpen24" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </ui:Button>
                        <Border Grid.Row="1" Margin="10,0" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <ui:Button Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                   Padding="10,0" BorderThickness="0" Background="Transparent" Click="ScriptFileBtn_OnClick"
                                   ToolTip="{Binding ScriptFilePath}" AutomationProperties.Name="定位剧本文件">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Script24" FontSize="18" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="剧本" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding ScriptFileName}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:SymbolIcon Grid.Column="3" Symbol="FolderOpen24" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </ui:Button>
                        <Border Grid.Row="3" Margin="10,0" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <ui:Button Grid.Row="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                   Padding="10,0" BorderThickness="0" Background="Transparent" Click="TranslateFileBtn_OnClick"
                                   ToolTip="{Binding TranslateFilePath}" AutomationProperties.Name="定位翻译文件">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Translate24" FontSize="18" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="翻译" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding TranslateFileName}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:SymbolIcon Grid.Column="3" Symbol="FolderOpen24" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </ui:Button>
                    </Grid>
                </ui:Card>
                <!--任务状态控制-->
                <ui:Card Grid.Row="1" Margin="0,5,0,0" VerticalAlignment="Bottom" Name="TaskStatusCard">
                    <StackPanel>
                        <!--状态控制-->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal">
                                <TextBlock
                                    Name="TextBlockStatus"
                                    Text="{Binding RunningStatus}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Name="TextBlockEta" Margin="5,0"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock
                                    Name="TextBlockFps" Margin="5,0"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Name="TextBlockProgression"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <!--状态监控-->
                        <StackPanel
                            Visibility="{calcBinding:Binding !HasNotStarted,FalseToVisibility=Collapsed}">
                            <ProgressBar Name="ProgressBarProgression" Height="8" Margin="5" />
                        </StackPanel>
                        <!--控制按钮-->
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:Button
                                Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                Click="StopButton_OnClick"
                                IsEnabled="{Binding CanStop}"
                                Content="终止任务" Appearance="Danger" />
                            <ui:Button
                                Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                Click="OutputButton_OnClick"
                                IsEnabled="{Binding Path=CanOutput}"
                                Margin="5,0" Content="输出" Appearance="Primary" />
                            <ui:Button
                                Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                Click="ResetButton_OnClick"
                                IsEnabled="{Binding CanReset}"
                                Content="移除任务" />
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </Grid>
            <!--视频处理预览-->
            <ui:Card Grid.Column="1"
                     Margin="5,0,0,0"
                     Padding="5,5" Name="FramePreviewCard" Height="240" Width="468"
                     PreviewMouseWheel="FramePreviewCard_OnPreviewMouseWheel"
                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Visibility="{calcBinding:Binding ShowPreview,FalseToVisibility=Hidden}"
                        Grid.RowSpan="2" Grid.ColumnSpan="2">
                        <ui:TextBlock
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                            暂无画面预览
                        </ui:TextBlock>
                        <ui:Image VerticalContentAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Name="FramePreviewImage" Stretch="Uniform"
                                  Source="{Binding FramePreviewImage,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <ui:Button x:Name="PreviewZoomOutButton" Click="PreviewZoomOutButton_OnClick" ToolTip="缩小预览（50px）" Margin="0,0,5,0">
                            <ui:SymbolIcon Symbol="Subtract24" />
                        </ui:Button>
                        <ui:Button x:Name="PreviewZoomInButton" Click="PreviewZoomInButton_OnClick" ToolTip="放大预览（50px）">
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <ui:Button Click="PreviewToggleBtn_OnClick" Margin="0"
                                   Appearance="{Binding ShowPreview,Converter={StaticResource BoolToAppearancePriOrSec}}">
                            显示预览
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
        <!--事件列表-->
        <Grid Grid.Row="1" VerticalAlignment="Stretch" MinHeight="120">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--事件筛选按钮-->
            <ui:Card Grid.Column="0" Padding="5" Margin="0,0,5,0"
                     VerticalAlignment="Stretch"
                     VerticalContentAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="55">
                            <ui:Button Click="DialogFilterBtn_OnClick" Margin="0" HorizontalAlignment="Stretch"
                                       Padding="2"
                                       Appearance="{Binding ShowDialog,Converter={StaticResource BoolToAppearancePriOrSec} }">
                                <StackPanel>
                                    <TextBlock TextAlignment="Center" Text="对话" />
                                    <TextBlock TextAlignment="Center" FontSize="10">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}/{1}">
                                                <Binding Path="DialogCurrent" Mode="OneWay" />
                                                <Binding Path="DialogTotal" Mode="OneWay" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <ui:Button Click="DialogFilterLine1Btn_OnClick" Margin="0,2"
                                               HorizontalAlignment="Stretch"
                                               Padding="2"
                                               Appearance="{Binding ShowDialogLine1,Converter={StaticResource BoolToAppearancePriOrSec}}"
                                               Content="单行" />
                                    <ui:Button Click="DialogFilterLine2Btn_OnClick" Margin="0,2"
                                               HorizontalAlignment="Stretch"
                                               Padding="2"
                                               Appearance="{Binding ShowDialogLine2,Converter={StaticResource BoolToAppearancePriOrSec}}"
                                               Content="双行" />
                                    <ui:Button Click="DialogFilterLine3Btn_OnClick" Margin="0,2"
                                               HorizontalAlignment="Stretch"
                                               Padding="2"
                                               Appearance="{Binding ShowDialogLine3,Converter={StaticResource BoolToAppearancePriOrSec}}"
                                               Content="三行" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Click="BannerFilterBtn_OnClick" Margin="0,5" HorizontalAlignment="Stretch"
                                       Padding="2"
                                       Appearance="{Binding ShowBanner,Converter={StaticResource BoolToAppearancePriOrSec}}">

                                <StackPanel>
                                    <TextBlock TextAlignment="Center" Text="横幅" />
                                    <TextBlock TextAlignment="Center" FontSize="10">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}/{1}">
                                                <Binding Path="BannerCurrent" Mode="OneWay" />
                                                <Binding Path="BannerTotal" Mode="OneWay" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Click="MarkerFilterBtn_OnClick" Margin="0" HorizontalAlignment="Stretch"
                                       Padding="2"
                                       Appearance="{Binding ShowMarker,Converter={StaticResource BoolToAppearancePriOrSec}}">
                                <StackPanel>
                                    <TextBlock TextAlignment="Center" Text="标签" />
                                    <TextBlock TextAlignment="Center" FontSize="10">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}/{1}">
                                                <Binding Path="MarkerCurrent" Mode="OneWay" />
                                                <Binding Path="MarkerTotal" Mode="OneWay" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <ui:Button Click="BackToTopBtn_OnClick"
                                       ToolTip="滚动到事件列表顶部"
                                       AutomationProperties.Name="滚动到事件列表顶部">
                                <ui:SymbolIcon Symbol="ArrowUp28" />
                            </ui:Button>
                            <ui:Button Click="BackToBottomBtn_OnClick"
                                       ToolTip="滚动到事件列表底部"
                                       AutomationProperties.Name="滚动到事件列表底部">
                                <ui:SymbolIcon Symbol="ArrowDown28" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </ui:Card>
            <!--事件列表-->
            <ui:Card Grid.Column="1" MinWidth="300" MinHeight="120" VerticalAlignment="Stretch"
                     VerticalContentAlignment="Stretch" Padding="0">
                <ui:PassiveScrollViewer
                    Name="LineViewer" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                    MaxHeight="{Binding RelativeSource= {RelativeSource Mode=FindAncestor, AncestorType=ui:CardControl}, Path=ActualHeight}">
                    <StackPanel Name="LinePanel" Margin="5,5,5,15" />
                </ui:PassiveScrollViewer>
            </ui:Card>
        </Grid>
        <!--时间轴-->
        <ScrollViewer x:Name="TimelineViewport" Grid.Row="2" Margin="0,6,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <components:TimelineEditor x:Name="EventTimelineEditor"
                                       IsReadOnly="{calcBinding:Binding 'IsRunning || HasNotStarted'}" />
        </ScrollViewer>
    </Grid>
</UserControl>