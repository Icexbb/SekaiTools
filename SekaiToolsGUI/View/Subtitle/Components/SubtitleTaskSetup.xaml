<UserControl x:Class="SekaiToolsGUI.View.Subtitle.Components.SubtitleTaskSetup"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:calcBinding="clr-namespace:CalcBinding;assembly=CalcBinding"
             xmlns:subtitle="clr-namespace:SekaiToolsGUI.ViewModel.Subtitle"
             xmlns:components="clr-namespace:SekaiToolsGUI.View.Subtitle.Components"
             xmlns:layout="clr-namespace:SekaiToolsGUI.Control"
             mc:Ignorable="d"
             d:Background="White"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance subtitle:SubtitlePageModel, IsDesignTimeCreatable=True}">
    <StackPanel
        MinWidth="400"
        VerticalAlignment="Center" HorizontalAlignment="Center"
        AllowDrop="True" DragEnter="UIElement_OnDragEnter" Drop="UIElement_OnDrop">
        <ui:Card Height="70" VerticalAlignment="Stretch"
                 Margin="0,0,0,5" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock
                        Margin="0"
                        FontTypography="BodyStrong"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="视频文件"
                        TextWrapping="NoWrap" />
                    <ui:TextBlock
                        Visibility="{calcBinding:Binding RelativeSource={RelativeSource Self}, Path='Text.Length!=0',FalseToVisibility=Collapsed}"
                        Appearance="Secondary"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding VideoFilePath}"
                        ToolTip="{Binding VideoFilePath}"
                        Name="TextBlockVideoFilePath"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ui:Button Grid.Column="1" HorizontalAlignment="Right"
                           IsEnabled="{Binding HasNotStarted}"
                           Content="浏览" Click="VideoFileBrowser_OnClick" />
            </Grid>
        </ui:Card>
        <ui:Card Height="70" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock
                        Margin="0"
                        FontTypography="BodyStrong"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="剧本文件"
                        TextWrapping="NoWrap" />
                    <ui:TextBlock
                        Visibility="{calcBinding:Binding RelativeSource={RelativeSource Self}, Path='Text.Length!=0',FalseToVisibility=Collapsed}"
                        Appearance="Secondary"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ScriptFilePath}"
                        ToolTip="{Binding ScriptFilePath}"
                        Name="TextBlockScriptFilePath"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ui:Button Grid.Column="1" HorizontalAlignment="Right"
                           IsEnabled="{Binding HasNotStarted}"
                           Content="浏览" Click="ScriptFileBrowser_OnClick" />
            </Grid>
        </ui:Card>
        <ui:Card Height="70" VerticalAlignment="Stretch" Margin="0,5,0,5"
                 HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock
                        Margin="0"
                        FontTypography="BodyStrong"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="翻译文件"
                        TextWrapping="NoWrap" />
                    <ui:TextBlock
                        Visibility="{calcBinding:Binding RelativeSource={RelativeSource Self}, Path='Text.Length!=0',FalseToVisibility=Collapsed}"
                        Appearance="Secondary"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding TranslateFilePath}"
                        ToolTip="{Binding TranslateFilePath}"
                        Name="TextBlockTranslationFilePath"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ui:Button Grid.Column="1" HorizontalAlignment="Right"
                           IsEnabled="{Binding HasNotStarted}"
                           Content="浏览" Click="TranslationFileBrowser_OnClick" />
            </Grid>
        </ui:Card>
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Click="StartButton_OnClick"
                       Margin="0,0,10,0" IsEnabled="{Binding CanStart}"
                       ToolTip="{Binding StartHint}"
                       ToolTipService.ShowOnDisabled="True"
                       HorizontalAlignment="Stretch" Appearance="Primary" Content="开始" />

            <ui:Button Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                       Content="历史记录" Click="HistoryButton_OnClick"
                       IsEnabled="{Binding HasNotStarted}" />

        </Grid>
    </StackPanel>
</UserControl>
