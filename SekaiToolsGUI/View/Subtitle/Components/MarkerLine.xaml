<UserControl x:Class="SekaiToolsGUI.View.Subtitle.Components.MarkerLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:SekaiToolsGUI.View.Subtitle.Components"
             xmlns:subtitle="clr-namespace:SekaiToolsGUI.ViewModel.Subtitle"
             mc:Ignorable="d" d:DesignWidth="760"
             d:DataContext="{d:DesignInstance subtitle:MarkerLineModel, IsDesignTimeCreatable=False}"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="PreviewVisibilityConverter" />
    </UserControl.Resources>
    <ui:Card Padding="0">
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#808080"
                    CornerRadius="3" />

            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Margin="0,0,5,0" Padding="10,4" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <TextBlock Text="{Binding EventNumber, Mode=OneWay}" FontWeight="SemiBold" />
                        </Border>
                        <Border Padding="10,4" CornerRadius="4" Background="#808080">
                            <TextBlock Text="标记" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} → {1}　{2}">
                                    <Binding Path="StartTime" Mode="OneWay" />
                                    <Binding Path="EndTime" Mode="OneWay" />
                                    <Binding Path="EventDuration" Mode="OneWay" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <ui:Button Name="LineEditBtn" FontSize="12" Margin="5,0,0,0" Padding="6,4" Click="LineEditBtn_OnClick"
                                   IsEnabled="{Binding DataContext.CanEditLine, RelativeSource={RelativeSource AncestorType={x:Type components:SubtitleTask}}, FallbackValue=False}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Edit24" Margin="0,0,4,0" />
                                <TextBlock Text="编辑" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Name="LinePreviewBtn" FontSize="12" Margin="5,0,0,0" Padding="6,4" Click="LinePreviewBtn_OnClick"
                                   IsEnabled="{Binding DataContext.CanStartLinePreview, RelativeSource={RelativeSource AncestorType={x:Type components:SubtitleTask}}, FallbackValue=False}"
                                   Visibility="{Binding DataContext.CanPreviewLine, RelativeSource={RelativeSource AncestorType={x:Type components:SubtitleTask}}, Converter={StaticResource PreviewVisibilityConverter}, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" Margin="0,0,4,0" />
                                <TextBlock Text="预览" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <ui:Card Margin="0,9,0,0"
                         MouseDoubleClick="MarkerLine_OnMouseDoubleClick">
                    <StackPanel>
                        <ui:TextBlock Text="{Binding RawContent, Mode=OneWay}"
                                      TextWrapping="NoWrap" />
                        <Separator Margin="-8,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Text="{Binding TranslatedContent, Mode=OneWay}"
                                          TextWrapping="NoWrap" />
                            <ui:Button Grid.Column="1" FontSize="12" Padding="6,4" Click="QuickEditBtn_OnClick"> 修改 </ui:Button>
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </Grid>
    </ui:Card>
</UserControl>