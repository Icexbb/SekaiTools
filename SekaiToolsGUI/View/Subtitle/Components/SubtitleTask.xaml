<UserControl x:Class="SekaiToolsGUI.View.Subtitle.Components.SubtitleTask"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:calcBinding="clr-namespace:CalcBinding;assembly=CalcBinding"
             xmlns:components="clr-namespace:SekaiToolsGUI.View.Subtitle.Components"
             xmlns:layout="clr-namespace:SekaiToolsGUI.Control"
             layout:AdaptiveLayout.MonitorSize="True"
             SizeChanged="SubtitleTask_OnSizeChanged">
    <Grid Margin="10">
        <components:SubtitleTaskProcess x:Name="ProcessView"
            StopRequested="StopButton_OnClick"
            OutputRequested="OutputButton_OnClick"
            ResetRequested="ResetButton_OnClick" />
    </Grid>
</UserControl>
