<ui:ContentDialog x:Class="SekaiToolsGUI.View.Subtitle.Components.SubtitleTaskDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:layout="clr-namespace:SekaiToolsGUI.Control"
                  xmlns:components="clr-namespace:SekaiToolsGUI.View.Subtitle.Components"
                  layout:AdaptiveLayout.DialogPurpose="Workspace"
                  Title="添加字幕任务" PrimaryButtonText="加入队列" CloseButtonText="取消"
                  DefaultButton="Primary" IsPrimaryButtonEnabled="False">
    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="components:SubtitleTaskDialog" />
    </ui:ContentDialog.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch">
            <components:SubtitleTaskSetup HorizontalAlignment="Stretch" />
            <ui:InfoBar x:Name="MaterialValidation" IsOpen="True" IsClosable="False"
                        Title="等待选择文件" Severity="Informational"
                        Message="请选择剧本和翻译文件，选择后自动检查适用性。"
                        Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</ui:ContentDialog>