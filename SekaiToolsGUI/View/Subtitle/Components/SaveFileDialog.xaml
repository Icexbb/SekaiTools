<ui:ContentDialog
    x:Class="SekaiToolsGUI.View.Subtitle.Components.SaveFileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SekaiToolsGUI.View.Subtitle.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:layout="clr-namespace:SekaiToolsGUI.Control"
    layout:AdaptiveLayout.FitDialog="True"
    xmlns:calcBinding="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:subtitle="clr-namespace:SekaiToolsGUI.ViewModel.Subtitle"
    mc:Ignorable="d"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    d:DataContext="{d:DesignInstance subtitle:SaveFileDialogModel, IsDesignTimeCreatable=True}"
    IsPrimaryButtonEnabled="True"
    Title="保存选项" DefaultButton="Primary"
    PrimaryButtonText="保存" CloseButtonText="取消"
    MinWidth="600">
    <ui:ContentDialog.Resources>
        <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
               TargetType="{x:Type local:SaveFileDialog}" />
    </ui:ContentDialog.Resources>
    <ui:ContentDialog.Content>
        <ScrollViewer>
            <StackPanel>
                <ui:CardControl Icon="{ui:SymbolIcon SaveSearch20}">
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ui:TextBlock
                                Grid.Row="0"
                                FontTypography="Body"
                                Text="文件将保存到 " />
                            <ui:TextBlock
                                Grid.Row="1"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding FileName}"
                                Visibility="{calcBinding:Binding 'FileName.Length>0', FalseToVisibility=Collapsed}" />
                            <ui:TextBlock
                                Grid.Row="1"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="请选择文件路径"
                                Visibility="{calcBinding:Binding 'FileName.Length==0', FalseToVisibility=Collapsed}" />
                        </Grid>
                    </ui:CardControl.Header>
                    <ui:Button Click="ButtonSelectFile_OnClick">浏览</ui:Button>
                </ui:CardControl>
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon CommentNote24}" ContentPadding="0" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="输出注释" />
                            <ui:TextBlock Grid.Row="1" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                          Text="选择本次输出的类别，仅对本次输出生效" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <StackPanel Orientation="Vertical">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type ui:TextBlock}">
                                <Setter Property="MinWidth" Value="20" />
                                <Setter Property="Margin" Value="10,0" />
                            </Style>
                        </StackPanel.Resources>
                        <ui:CardControl Icon="{ui:SymbolIcon TextDescription24}">
                            <ui:CardControl.Header>
                                <ui:TextBlock FontTypography="Body" Text="对话" />
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <StackPanel Orientation="Horizontal" Margin="5,0">
                                        <CheckBox Content="一行" IsChecked="{Binding ExportLine1, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5,0">
                                        <CheckBox Content="二行" IsChecked="{Binding ExportLine2, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" Margin="5,0">
                                        <CheckBox Content="三行" IsChecked="{Binding ExportLine3, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Person24}">
                            <ui:CardControl.Header>
                                <ui:TextBlock FontTypography="Body" Text="说话人" />
                            </ui:CardControl.Header>
                            <StackPanel>
                                <CheckBox Content="与原文不同" Margin="5,0,5,5"
                                          IsChecked="{Binding ExportCharacter, Mode=TwoWay}" />
                                <CheckBox Content="与原文相同" Margin="5,0"
                                          IsChecked="{Binding ExportUnchangedCharacter, Mode=TwoWay}" />
                            </StackPanel>
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Location24}">
                            <ui:CardControl.Header>
                                <ui:TextBlock FontTypography="Body" Text="横幅" />
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Margin="5,0">
                                    <CheckBox Content="遮罩" IsChecked="{Binding ExportBannerMask, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,0">
                                    <CheckBox Content="内容" IsChecked="{Binding ExportBannerText, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Bookmark24}">
                            <ui:CardControl.Header>
                                <ui:TextBlock FontTypography="Body" Text="地点角标" />
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Margin="5,0">
                                    <CheckBox Content="遮罩" IsChecked="{Binding ExportMarkerMask, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,0">
                                    <CheckBox Content="内容" IsChecked="{Binding ExportMarkerText, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon Comment24}">
                            <ui:CardControl.Header>
                                <ui:TextBlock FontTypography="Body" Text="其他注释" />
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5,0">
                                <CheckBox Content="注释" IsChecked="{Binding ExportScreenComment, Mode=TwoWay}" />
                            </StackPanel>
                        </ui:CardControl>
                    </StackPanel>
                </ui:CardExpander>
                <ui:CardExpander Icon="{ui:SymbolIcon People24}" IsExpanded="True" ContentPadding="0">
                    <ui:CardExpander.Header>
                        <ui:TextBlock
                            Grid.Row="0"
                            FontTypography="Body"
                            Text="Staff信息" />
                    </ui:CardExpander.Header>
                    <StackPanel Orientation="Vertical">
                        <ui:CardControl>
                            <ui:CardControl.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ui:TextBlock
                                        Grid.Row="0"
                                        FontTypography="Body"
                                        Text="Staff行时长" />
                                    <ui:TextBlock
                                        Grid.Row="1"
                                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                        Text="设为0以不使用Staff行" />
                                </Grid>
                            </ui:CardControl.Header>
                            <ui:NumberBox Width="150" Maximum="15" Minimum="0" SmallChange="0.1"
                                          Value="{Binding StaffLineTime,Mode=TwoWay}" />
                        </ui:CardControl>
                        <Grid Visibility="{calcBinding:Binding 'StaffLineTime>0',FalseToVisibility=Collapsed}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <ui:CardControl Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3">
                                <ui:CardControl.Header>
                                    <ui:TextBlock FontTypography="Body" Text="前缀" />
                                </ui:CardControl.Header>
                                <ui:TextBox MinWidth="400" Text="{Binding StaffLinePrefix}" />
                            </ui:CardControl>
                            <ui:CardControl Grid.Column="0" Grid.Row="1">
                                <ui:CardControl.Header>
                                    <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="录制" />
                                </ui:CardControl.Header>
                                <ui:TextBox Width="100" Text="{Binding StaffLineRecord}" />
                            </ui:CardControl>
                            <ui:CardControl Grid.Column="1" Grid.Row="1">
                                <ui:CardControl.Header>
                                    <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="翻译" />
                                </ui:CardControl.Header>
                                <ui:TextBox Width="100" Text="{Binding StaffLineTranslator}" />
                            </ui:CardControl>
                            <ui:CardControl Grid.Column="2" Grid.Row="1">
                                <ui:CardControl.Header>
                                    <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="校对" />
                                </ui:CardControl.Header>
                                <ui:TextBox Width="100" Text="{Binding StaffLineTranslatorSenior}" />
                            </ui:CardControl>
                            <ui:CardControl Grid.Column="0" Grid.Row="2">
                                <ui:CardControl.Header>
                                    <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="时轴" />
                                </ui:CardControl.Header>
                                <ui:TextBox Width="100" Text="{Binding StaffLineTimeline}" />
                            </ui:CardControl>
                            <ui:CardControl Grid.Column="1" Grid.Row="2">
                                <ui:CardControl.Header>
                                    <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="轴校" />
                                </ui:CardControl.Header>
                                <ui:TextBox Width="100" Text="{Binding StaffLineTimelineSenior}" />
                            </ui:CardControl>
                            <ui:CardControl Grid.Column="2" Grid.Row="2">
                                <ui:CardControl.Header>
                                    <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="压制" />
                                </ui:CardControl.Header>
                                <ui:TextBox Width="100" Text="{Binding StaffLineCompression}" />
                            </ui:CardControl>

                            <ui:CardControl Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3">
                                <ui:CardControl.Header>
                                    <ui:TextBlock FontTypography="Body" Text="后缀" />
                                </ui:CardControl.Header>
                                <ui:TextBox MinWidth="400" Text="{Binding StaffLineSuffix}" />
                            </ui:CardControl>
                            <ui:CardControl Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="3">
                                <ui:CardControl.Header>
                                    <ui:TextBlock FontTypography="Body" Text="位置" />
                                </ui:CardControl.Header>
                                <ComboBox Width="100" SelectedIndex="{Binding StaffLinePositionIndex,Mode=TwoWay}">
                                    <ComboBoxItem>左下</ComboBoxItem>
                                    <ComboBoxItem>左上</ComboBoxItem>
                                    <ComboBoxItem>右下</ComboBoxItem>
                                    <ComboBoxItem>右上</ComboBoxItem>
                                </ComboBox>
                            </ui:CardControl>
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>
    </ui:ContentDialog.Content>
</ui:ContentDialog>
