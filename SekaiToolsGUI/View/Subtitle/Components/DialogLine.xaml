<UserControl x:Class="SekaiToolsGUI.View.Subtitle.Components.DialogLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:subtitle="clr-namespace:SekaiToolsGUI.ViewModel.Subtitle"
             mc:Ignorable="d" d:DesignWidth="760"
             d:DataContext="{d:DesignInstance subtitle:DialogLineModel, IsDesignTimeCreatable=False}"
             PreviewMouseLeftButtonDown="DialogLine_OnPreviewMouseLeftButtonDown"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="SpeakerColorBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSpeakerColor}" Value="True">
                    <Setter Property="Background" Value="{Binding SpeakerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SpeakerColorTextStyle" TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSpeakerColor}" Value="True">
                    <Setter Property="Foreground" Value="{Binding SpeakerForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ui:Card Padding="0">
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SpeakerColorBorderStyle}"
                    CornerRadius="3" />

            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <!-- 角色与事件时间 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Margin="0,0,5,0" Padding="10,4" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <TextBlock Text="{Binding EventNumber, Mode=OneWay}" FontWeight="SemiBold" />
                        </Border>
                        <Border Margin="0,0,5,0" Padding="10,4" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <TextBlock Text="对话" />
                        </Border>
                        <Border Padding="10,4" CornerRadius="4"
                                Style="{StaticResource SpeakerColorBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SpeakerName, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource SpeakerColorTextStyle}" />
                                <TextBlock Text="{Binding SpeakerOriginalName, Mode=OneWay}"
                                           FontSize="10" Opacity="0.75" TextAlignment="Justify"
                                           VerticalAlignment="Center"
                                           Margin="3,0"
                                           Style="{StaticResource SpeakerColorTextStyle}"
                                           Visibility="{Binding SpeakerOriginalNameVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <!-- 抖动行标识 -->
                        <ui:SymbolIcon Margin="8,0,0,0" Symbol="PhoneShake24"
                                       ToolTip="抖动行"
                                       Visibility="{Binding ShakeVisibility}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} → {1}　{2}">
                                <Binding Path="StartTime" Mode="OneWay" />
                                <Binding Path="EndTime" Mode="OneWay" />
                                <Binding Path="EventDuration" Mode="OneWay" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>

                <!-- 原文与翻译同时展示；双击打开快速编辑 -->
                <ui:Card Margin="0,9,0,0"
                         MouseDoubleClick="DialogLine_OnMouseDoubleClick">
                    <StackPanel>
                        <ui:TextBlock Text="{Binding RawContent, Mode=OneWay}"
                                      TextWrapping="NoWrap" />
                        <Separator Margin="-8,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Text="{Binding TranslatedContent, Mode=OneWay}"
                                          TextWrapping="NoWrap" />
                            <ui:Button Grid.Column="1" FontSize="12" Padding="6,4" Click="QuickEditBtn_OnClick"> 修改 </ui:Button>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 长文本分割设置默认收入抽屉，点击标题展开 -->
                <Expander Name="PanelSeparator" Margin="0,8,0,0" IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TextContinuous24" Margin="0,0,6,0" />
                            <TextBlock Text="长文本分割设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="8,6,8,4">
                        <Separator Margin="0,0,0,8" />
                        <Grid>
                            <TextBlock Text="将文本分割为：" />
                            <TextBlock Text="*本行文本发生抖动*" HorizontalAlignment="Right"
                                       Visibility="{c:Binding Path=IsDialogJitter,FalseToVisibility=Collapsed}" />
                        </Grid>
                        <TextBlock Margin="10,6" TextWrapping="WrapWithOverflow" TextAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="ContentPart1" Mode="OneWay" />
                                    <Binding Path="ContentPart2" Mode="OneWay" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="5" Text="{Binding ContentPart1.Length}" />
                            <Slider Grid.Column="1" Minimum="1" VerticalAlignment="Center"
                                    Maximum="{Binding SeparatorContentIndexLimit}"
                                    Value="{Binding SeparatorContentIndex}" />
                            <TextBlock Grid.Column="2" Margin="5" Text="{Binding ContentPart2.Length}" />
                        </Grid>

                        <Separator Margin="0,8" />

                        <Grid>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} ⇒ {1}">
                                        <Binding Path="StartFrame" Mode="OneWay" />
                                        <Binding Path="StartTime" Mode="OneWay" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} ⇒ {1}">
                                        <Binding Path="EndFrame" Mode="OneWay" />
                                        <Binding Path="EndTime" Mode="OneWay" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <Slider Minimum="{Binding StartFrame}" Maximum="{Binding EndFrame}"
                                Value="{Binding SeparateFrame}" />
                        <TextBlock HorizontalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}在 {0} ⇒ {1} 处换行">
                                    <Binding Path="SeparateFrame" Mode="OneWay" />
                                    <Binding Path="SeparateTime" Mode="OneWay" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <!-- 警告信息 -->
                <TextBlock Margin="5" HorizontalAlignment="Center" Foreground="OrangeRed"
                           Text="{Binding PromptWarning,Mode=OneWay}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{c:Binding RelativeSource={RelativeSource Self},
                               Path='Text.Length!=0',FalseToVisibility=Collapsed}" />
            </StackPanel>
        </Grid>
    </ui:Card>
</UserControl>