<UserControl x:Class="SekaiToolsGUI.View.Download.Components.Event.EventStoryEvent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">
    <ui:CardExpander VerticalContentAlignment="Center" HorizontalAlignment="Stretch" ContentPadding="10,5">
        <ui:CardExpander.Header>
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition MinWidth="20" Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:InfoBadge Name="IndexInfoBadge" Severity="Attention" />
                    <ui:InfoBadge Name="IndexInfoBadgeEx" Severity="Informational" />
                    <ui:TextBlock Name="TextBlockTitle" Text="TitleHere" VerticalAlignment="Center"
                                  FontWeight="DemiBold" />
                </StackPanel>


                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <StackPanel Name="IconContainer" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="10,0">
                        <Image Height="24" Width="24" Source="pack://application:,,,/Resource/Characters/chr_1.png" />
                    </StackPanel>

                    <ui:Button x:Name="AddAllButton" IsEnabled="False"
                               VerticalAlignment="Center" Margin="8,0,8,0"
                               ToolTip="将本活动全部章节加入下载列表" AutomationProperties.Name="添加本活动全部章节"
                               Click="AddAll_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="AddCircle24" Margin="0,0,6,0" />
                            <TextBlock Text="添加全部" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

            </Grid>
        </ui:CardExpander.Header>
        <ui:CardExpander.Content>
            <Grid Name="PanelItems" />
        </ui:CardExpander.Content>
    </ui:CardExpander>
</UserControl>