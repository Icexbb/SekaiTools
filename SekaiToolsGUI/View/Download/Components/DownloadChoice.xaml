<UserControl x:Class="SekaiToolsGUI.View.Download.Components.DownloadChoice"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <CheckBox x:Name="ChoiceBox" VerticalAlignment="Center" Margin="8,0,0,0" Padding="0" MinWidth="0" FontSize="12"
