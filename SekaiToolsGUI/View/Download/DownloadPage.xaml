<UserControl x:Class="SekaiToolsGUI.View.Download.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:download1="clr-namespace:SekaiToolsGUI.ViewModel.Download"
             xmlns:control="clr-namespace:SekaiToolsGUI.Control"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"

             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance download1:DownloadPageModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="400" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Grid.Row="0">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,10,0" Text="数据源" VerticalAlignment="Center" />
                    <ComboBox Name="BoxSource" ItemsSource="{Binding SourceData, NotifyOnTargetUpdated=True}"
                              TargetUpdated="SourceSelector_OnTargetUpdated"
                              AutomationProperties.Name="数据源" MinWidth="120"
                              SelectedIndex="{Binding CurrentSourceIndex, Mode=OneWay}"
                              SelectionChanged="SourceSelector_OnSelected">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceName }" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Margin="0,0,8,0" ToolTip="打开下载的剧本文件夹"
                            AutomationProperties.Name="打开下载文件夹" Click="OpenDownloadFolder_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                            <TextBlock Text="打开下载文件夹" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearCacheButton" Margin="0,0,8,0"
                            ToolTip="清除所有数据源的列表缓存" Click="ButtonClearCache_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0" />
                            <TextBlock Text="清除列表缓存" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshButton" Click="ButtonRefresh_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
                            <TextBlock Text="刷新当前列表" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <ui:Card Margin="0,0,0,5" Padding="5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <control:SelectorBar x:Name="BoxStoryType" HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Stretch"
                                     AutomationProperties.Name="剧情类型"
                                     SelectionChanged="StoryTypeSelector_OnSelected">
                    <control:SelectorBar.Items>
                        <control:SelectorBarItem Content="主线剧情" />
                        <control:SelectorBarItem Content="活动剧情" />
                        <control:SelectorBarItem Content="特殊剧情" />
                        <control:SelectorBarItem Content="角色剧情" />
                        <control:SelectorBarItem Content="地图对话" />
                    </control:SelectorBar.Items>
                </control:SelectorBar>
            </ui:Card>
            <StackPanel x:Name="BrowserBar" IsEnabled="False" Margin="0,3,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="SearchBox" PlaceholderText="搜索当前列表：标题、ID、剧本名"
                                TextChanged="Search_OnTextChanged"
                                AutomationProperties.Name="搜索当前剧情列表" />
                    <Button x:Name="ResetSearchButton" Grid.Column="1" Margin="8,0,0,0" Padding="10,6"
                            ToolTip="清空关键词并重置当前分类筛选"
                            Click="ResetSearch_OnClick" AutomationProperties.Name="重置搜索和筛选">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="重置" />
                        </StackPanel>
                    </Button>
                </Grid>
                <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BrowserResultText" Text="正在准备列表…" FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <CheckBox x:Name="SelectResultsBox" Content="选择当前结果" Click="SelectResults_OnClick"
                              VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="AddSelectedButton" IsEnabled="False" Click="AddSelected_OnClick" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="AddCircle24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock x:Name="AddSelectedText" Text="加入已选" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
        <ContentControl Grid.Column="0" Grid.Row="1"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Name="ContentCard" />
        <StackPanel x:Name="BrowserEmptyPanel" Grid.Column="0" Grid.Row="1" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="16">
            <ui:SymbolIcon Symbol="Search24" FontSize="28" HorizontalAlignment="Center" Opacity="0.65" />
            <TextBlock x:Name="BrowserEmptyText" Text="当前没有可下载结果" Margin="0,8,0,0" TextWrapping="Wrap"
                       TextAlignment="Center" />
            <TextBlock Text="可调整筛选、重置搜索，或刷新当前列表" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid x:Name="LoadingPanel" Grid.Column="0" Grid.Row="1" Visibility="Collapsed">
            <TextBlock x:Name="LoadingMessage" Text="正在加载剧情列表…"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
        <ui:Card x:Name="QueueCard" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                 VerticalContentAlignment="Stretch" Padding="0" Margin="10,0,0,0"
                 VerticalAlignment="Stretch" Width="320">
            <ui:Card.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="QueueHeader" Grid.Row="0" Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Name="TaskCountText"
                                      Text="下载列表 (0)"
                                      TextAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="QueueDetailsButton" Grid.Column="2" Visibility="Collapsed" Padding="8"
                                Margin="8,0,0,0"
                                Click="QueueDetails_OnClick" ToolTip="展开下载列表" AutomationProperties.Name="展开或收起下载列表">
                            <ui:SymbolIcon x:Name="QueueDetailsIcon" Symbol="ChevronDown24" FontSize="16" />
                        </Button>
                    </Grid>
                    <Grid x:Name="QueueBody" Grid.Row="1" VerticalAlignment="Stretch">
                        <ScrollViewer Margin="8,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl VerticalAlignment="Top"
                                          HorizontalAlignment="Stretch"
                                          Name="DownloadItemBox" />
                        </ScrollViewer>
                        <StackPanel Name="EmptyTaskPanel" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" IsHitTestVisible="False">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="28"
                                           HorizontalAlignment="Center" Opacity="0.7" />
                            <TextBlock Margin="0,8,0,0" Text="暂无下载任务"
                                       HorizontalAlignment="Center" />
                            <TextBlock Margin="0,4,0,0" Text="点击左侧剧情即可加入"
                                       FontSize="12" Opacity="0.7"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="QueueFooter" Grid.Row="2" Margin="12,8,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Name="BatchStatusText" Text="选择剧情后开始下载"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Name="BatchProgress" Height="4" Margin="0,8,0,12"
                                     Minimum="0" Maximum="1" Value="0"
                                     AutomationProperties.Name="本批下载任务进度" />
                        <Grid x:Name="DirectoryGrid" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Name="DirectoryText" FontSize="12" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Button Name="ChooseDirectoryButton" Grid.Column="1" Padding="6" Margin="8,0,0,0"
                                    ToolTip="更改下载目录（应用于未完成任务）" AutomationProperties.Name="更改下载目录"
                                    Click="ChooseDirectory_OnClick">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                            </Button>
                        </Grid>
                        <ComboBox Grid.Row="3" Grid.ColumnSpan="2" Name="FilePolicyBox" SelectedIndex="0"
                                  Margin="0,0,0,8" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="同名文件处理方式">
                            <ComboBoxItem Content="已有同名文件：跳过" />
                            <ComboBoxItem Content="已有同名文件：替换" />
                        </ComboBox>
                        <Button Grid.Row="4" Grid.ColumnSpan="2" Name="RetryFailedButton" Visibility="Collapsed"
                                Click="RetryFailed_OnClick" Margin="0,0,0,8" Padding="8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Name="RetryFailedText" Text="重试失败项" />
                            </StackPanel>
                        </Button>
                        <Grid x:Name="MainActions" Grid.Row="5" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Name="TaskClearButton" IsEnabled="False"
                                       Click="ClearButton_OnClick"
                                       Margin="0,0,8,0" Padding="10" ToolTip="清空下载列表，不删除文件"
                                       AutomationProperties.Name="清空下载列表">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="18" />
                            </ui:Button>
                            <ui:Button Grid.Column="1" Name="DownloadButton" IsEnabled="False" Appearance="Primary"
                                       Click="DownloadButton_OnClick" HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Center" Padding="10">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Name="DownloadActionIcon" Symbol="ArrowDownload24" FontSize="18"
                                                   Margin="0,0,6,0" />
                                    <TextBlock Name="DownloadActionText" Text="开始下载" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Grid>
                </Grid>
            </ui:Card.Content>
        </ui:Card>
    </Grid>
</UserControl>