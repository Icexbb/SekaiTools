<ui:FluentWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModel="clr-namespace:SekaiToolsGUI.ViewModel"
    xmlns:control="clr-namespace:SekaiToolsGUI.Control"
    x:Class="SekaiToolsGUI.MainWindow"
    AutomationProperties.AutomationId="MainWindow.Root"
    mc:Ignorable="d"
    Icon="pack://application:,,,/Resource/icon.png"
    MinHeight="600" MinWidth="960"
    Height="960" Width="1280"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    d:DataContext="{d:DesignInstance viewModel:MainWindowViewModel,IsDesignTimeCreatable=True}"
    Loaded="MainWindow_OnLoaded">
    <Grid control:AdaptiveLayout.MonitorSize="True" Background="{DynamicResource ST.Brush.App}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:Button x:Name="UpdateButton" Grid.Row="1" HorizontalAlignment="Right" Margin="0,4,16,4"
                   Visibility="Collapsed" IsEnabled="False" Click="RestartForUpdate_Click">
            <ui:Button.Icon>
                <ui:SymbolIcon Symbol="ArrowDownload24" />
            </ui:Button.Icon>
        </ui:Button>
        <Border Grid.Row="2" Background="{DynamicResource ST.Brush.Workspace}" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <control:WorkbenchPageHeader x:Name="ShellHeader" Title="脚本翻译" Icon="Translate24"
                    AutomationProperties.AutomationId="MainWindow.PageHeader" Margin="0,0,16,0"/>
                <control:WorkbenchPageToolbar AutomationProperties.AutomationId="MainWindow.PageToolbar">
                    <control:WorkbenchPageToolbar.Style>
                        <Style TargetType="control:WorkbenchPageToolbar">
                            <Setter Property="Grid.Column" Value="1"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="control:AdaptiveLayout.IsNarrow" Value="True">
                                    <Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0,8,0,0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </control:WorkbenchPageToolbar.Style>
                    <ui:Button x:Name="PaneToggleButton" Click="ToggleNavigation_OnClick"
                        Icon="{ui:SymbolIcon PanelLeft24}" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="MainWindow.ToggleNavigation">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ST.Button}">
                                <Setter Property="Content" Value="展开导航"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsPaneOpen, ElementName=NavigationView}" Value="True">
                                    <Setter Property="Content" Value="收起导航"/>
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button Content="运行日志" Click="OpenRuntimeLogs_OnClick" Icon="{ui:SymbolIcon ClipboardTask24}"
                        Style="{StaticResource ST.Button}" AutomationProperties.AutomationId="MainWindow.OpenLogs"/>
                </control:WorkbenchPageToolbar>
            </Grid>
        </Border>
        <control:AccessibleNavigationView
            Style="{StaticResource {x:Type ui:NavigationView}}"
            Grid.Row="3"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            x:Name="NavigationView"
            AutomationProperties.AutomationId="MainWindow.Navigation"
            AutomationProperties.Name="主导航与工作区"
            MenuItemsSource="{Binding NavigationItems}"
            FooterMenuItemsSource="{Binding NavigationFooterItems}"
            Loaded="NavigationView_OnLoaded" HorizontalContentAlignment="Stretch"
            Navigating="NavigationView_OnNavigating"
            Navigated="NavigationView_OnNavigated"
            VerticalContentAlignment="Stretch"
            OpenPaneLength="150"
            Transition="FadeInWithSlide"
            PaneDisplayMode="LeftMinimal"
            FrameMargin="0"
            HeaderVisibility="Collapsed">
            <ui:NavigationView.ContentOverlay>
                <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
            </ui:NavigationView.ContentOverlay>
        </control:AccessibleNavigationView>
        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.Row="1" Grid.RowSpan="3"
                              AutomationProperties.AutomationId="MainWindow.DialogHost" />
        <ui:TitleBar Name="TitleBar" Grid.Row="0" Title="Sekai Tools">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resource/icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>
