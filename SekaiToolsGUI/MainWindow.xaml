<ui:FluentWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModel="clr-namespace:SekaiToolsGUI.ViewModel"
    xmlns:control="clr-namespace:SekaiToolsGUI.Control"
    x:Class="SekaiToolsGUI.MainWindow"
    AutomationProperties.AutomationId="MainWindow.Root"
    mc:Ignorable="d"
    Icon="pack://application:,,,/Resource/icon.png"
    MinHeight="600" MinWidth="960"
    Height="960" Width="1280"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    d:DataContext="{d:DesignInstance viewModel:MainWindowViewModel,IsDesignTimeCreatable=True}"
    Loaded="MainWindow_OnLoaded">
    <Grid control:AdaptiveLayout.MonitorSize="True" Background="{DynamicResource ST.Brush.App}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:Button x:Name="UpdateButton" Grid.Row="1" HorizontalAlignment="Right" Margin="0,4,16,4"
                   Visibility="Collapsed" IsEnabled="False" Click="RestartForUpdate_Click">
            <ui:Button.Icon>
                <ui:SymbolIcon Symbol="ArrowDownload24" />
            </ui:Button.Icon>
        </ui:Button>
        <control:AccessibleNavigationView
            Style="{StaticResource {x:Type ui:NavigationView}}"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            x:Name="NavigationView"
            AutomationProperties.AutomationId="MainWindow.Navigation"
            AutomationProperties.Name="主导航与工作区"
            MenuItemsSource="{Binding NavigationItems}"
            FooterMenuItemsSource="{Binding NavigationFooterItems}"
            Loaded="NavigationView_OnLoaded" HorizontalContentAlignment="Stretch"
            Navigating="NavigationView_OnNavigating"
            Navigated="NavigationView_OnNavigated"
            VerticalContentAlignment="Stretch"
            OpenPaneLength="150"
            Transition="FadeInWithSlide"
            PaneDisplayMode="LeftMinimal"
            FrameMargin="0"
            HeaderVisibility="Collapsed">
            <ui:NavigationView.PaneHeader>
                <ui:Button Click="ToggleNavigation_OnClick" Height="32" MinWidth="0" Margin="0" Padding="4"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Appearance="Transparent"
                    AutomationProperties.AutomationId="MainWindow.ToggleNavigation">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource ST.Button}">
                            <Setter Property="ToolTip" Value="展开导航"/>
                            <Setter Property="AutomationProperties.Name" Value="展开导航"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaneOpen, ElementName=NavigationView}" Value="True">
                                    <Setter Property="ToolTip" Value="收起导航"/><Setter Property="AutomationProperties.Name" Value="收起导航"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PanelLeft24" FontSize="20" Width="20" Height="20"/>
                        <TextBlock Text="收起导航" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsPaneOpen, ElementName=NavigationView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ui:Button>
            </ui:NavigationView.PaneHeader>
            <ui:NavigationView.PaneFooter>
                <ui:Button Click="OpenRuntimeLogs_OnClick" Height="32" MinWidth="0" Margin="0" Padding="4"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Appearance="Transparent"
                    Style="{StaticResource ST.Button}" ToolTip="运行日志"
                    AutomationProperties.AutomationId="MainWindow.OpenLogs" AutomationProperties.Name="运行日志">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ClipboardTask24" FontSize="20" Width="20" Height="20"/>
                        <TextBlock Text="运行日志" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsPaneOpen, ElementName=NavigationView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ui:Button>
            </ui:NavigationView.PaneFooter>
            <ui:NavigationView.ContentOverlay>
                <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
            </ui:NavigationView.ContentOverlay>
        </control:AccessibleNavigationView>
        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.Row="1" Grid.RowSpan="2"
                              AutomationProperties.AutomationId="MainWindow.DialogHost" />
        <ui:TitleBar Name="TitleBar" Grid.Row="0" Title="Sekai Tools">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resource/icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>
