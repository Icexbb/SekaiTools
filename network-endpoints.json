{
  "github": {
    "repositoryUrl": "https://github.com/Icexbb/SekaiTools",
    "latestReleaseApiUrl": "https://api.github.com/repos/Icexbb/SekaiTools/releases/latest",
    "releaseDownloadBaseUrl": "https://github.com/Icexbb/SekaiTools/releases/download/"
  },
  "resources": {
    "baseUrl": "https://v.xbb.moe/files/sekai-tools/",
    "sourceListUrl": "https://v.xbb.moe/files/sekai-tools/source.json"
  },
  "defaultDataSources":[
    {
      "SourceName": "Sekai Best",
      "SourceTemplate": "https://sekai-world.github.io/sekai-master-db-diff/{type}.json",
      "StorageBaseUrl": "https://storage.sekai.best/sekai-jp-assets/",
      "ActionSetTemplate": "scenario/actionset/{abName}/{scenarioId}.asset",
      "MemberStoryTemplate": "character/member/{abName}/{scenarioId}.asset",
      "EventStoryTemplate": "event_story/{abName}/scenario/{scenarioId}.asset",
      "SpecialStoryTemplate": "scenario/special/{abName}/{scenarioId}.asset",
      "UnitStoryTemplate": "scenario/unitstory/{abName}/{scenarioId}.asset"
    },
    {
      "SourceName": "Haruki NEO",
      "SourceTemplate": "https://sekai-master-direct.haruki.seiunx.com/haruki-sekai-master/master/{type}.json",
      "StorageBaseUrl": "https://production-sekai-assets.neo.bot.haruki.seiunx.com/jp-assets/",
      "ActionSetTemplate": "startapp/scenario/actionset/{abName}/{scenarioId}.json",
      "MemberStoryTemplate": "startapp/character/member/{abName}/{scenarioId}.json",
      "EventStoryTemplate": "ondemand/event_story/{abName}/scenario/{scenarioId}.json",
      "SpecialStoryTemplate": "startapp/scenario/special/{abName}/{scenarioId}.json",
      "UnitStoryTemplate": "startapp/scenario/unitstory/{abName}/{scenarioId}.json"
    }
  ]
}
