diff --git a/SekaiTools.Tests/PreparedMatchingTests.cs b/SekaiTools.Tests/PreparedMatchingTests.cs
new file mode 100644
index 0000000..07def89
--- /dev/null
+++ b/SekaiTools.Tests/PreparedMatchingTests.cs
@@ -0,0 +1,71 @@
+using System.Drawing;
+using System.Runtime.InteropServices;
+using Emgu.CV;
+using Emgu.CV.CvEnum;
+using Emgu.CV.Structure;
+using SekaiToolsCore.Process.Model;
+using SekaiToolsCore.Match.TemplateMatcher;
+
+namespace SekaiTools.Tests;
+
+public class PreparedMatchingTests
+{
+    [Theory]
+    [InlineData(1d, 1)]
+    [InlineData(.96, 2)]
+    [InlineData(1.04, 2)]
+    public void PreparedTemplatePreservesEveryScoreIncludingNonfiniteValues(double scale, int divisor)
+    {
+        using var source = new Mat(20, 24, DepthType.Cv8U, 4);
+        source.SetTo(new MCvScalar(20, 20, 20, 0));
+        CvInvoke.Rectangle(source, new Rectangle(3, 2, 7, 14), new MCvScalar(240, 240, 240, 1), -1);
+        CvInvoke.Rectangle(source, new Rectangle(13, 6, 8, 5), new MCvScalar(130, 130, 130, 128), -1);
+        using var template = new GaMat(source, false);
+        var original = template.GetScaledLayer(scale, divisor);
+        var prepared = template.GetPreparedLayer(scale, divisor);
+        Assert.Same(prepared.Gray, template.GetPreparedLayer(scale, divisor).Gray);
+        using var image = new Mat(40, 50, DepthType.Cv8U, 1);
+        image.SetTo(new MCvScalar(0));
+        using (var target = new Mat(image, new Rectangle(new Point(11, 7), original.Size))) original.Gray.CopyTo(target);
+        using var imageFloat = new Mat();
+        image.ConvertTo(imageFloat, DepthType.Cv32F);
+        using var left = new Mat();
+        using var right = new Mat();
+        CvInvoke.MatchTemplate(image, original.Gray, left, TemplateMatchingType.CcoeffNormed, original.Alpha);
+        CvInvoke.MatchTemplate(imageFloat, prepared.Gray, right, TemplateMatchingType.CcoeffNormed, prepared.Alpha);
+        Assert.Equal(ScoreBits(left), ScoreBits(right));
+    }
+
+    [Fact]
+    public void FloatMaskKeepsFractionalWeights()
+    {
+        using var source = new Mat(10, 12, DepthType.Cv32F, 4);
+        source.SetTo(new MCvScalar(20, 30, 40, .25));
+        using var template = new GaMat(source, false);
+        var prepared = template.GetPreparedLayer(1, 1);
+        Assert.Equal(0, CvInvoke.Norm(template.Alpha, prepared.Alpha, NormType.C));
+    }
+
+    [Fact]
+    public void ChangingFramesRefreshesPreparedImage()
+    {
+        using var context = new FrameMatchContext();
+        using var source = new Mat(40, 50, DepthType.Cv8U, 1);
+        foreach (var value in new[] { 12, 200 })
+        {
+            source.SetTo(new MCvScalar(value));
+            context.Update(source);
+            using var prepared = context.PrepareMatchImage(context.Gray);
+            using var expected = new Mat();
+            source.ConvertTo(expected, DepthType.Cv32F);
+            Assert.Equal(0, CvInvoke.Norm(expected, prepared.Image, NormType.C));
+        }
+    }
+
+    private static int[] ScoreBits(Mat result)
+    {
+        var scores = new float[result.Rows * result.Cols];
+        for (var row = 0; row < result.Rows; row++) Marshal.Copy(result.DataPointer + row * result.Step, scores, row * result.Cols, result.Cols);
+        return scores.Select(BitConverter.SingleToInt32Bits).ToArray();
+    }
+}
