{
  "replacements": [
    { "pattern": "…", "replacement": "..." },
    { "pattern": "\\(", "replacement": "（" },
    { "pattern": "\\)", "replacement": "）" },
    { "pattern": ",", "replacement": "，" },
    { "pattern": "\\?", "replacement": "？" },
    { "pattern": "!", "replacement": "！" },
    { "pattern": "欸", "replacement": "诶" }
  ],
  "checks": [
    {
      "id": "missing-end-punctuation",
      "scope": "line",
      "conditions": [
        { "pattern": "[、，。？！~♪☆.—][）」』”]*$", "match": false }
      ],
      "feedback": { "message": "句尾缺少结束标点（如逗号、句号、问号、感叹号）" }
    },
    {
      "id": "ellipsis-punctuation",
      "scope": "line",
      "conditions": [ { "pattern": "\\.[，。][）」』”]*$" } ],
      "feedback": { "message": "「……。」和「……，」只保留省略号" }
    },
    {
      "id": "mixed-dash-groups",
      "scope": "line",
      "conditions": [
        { "pattern": "——" },
        { "pattern": "(?<!—)(?:——)*—(?!—)" }
      ],
      "feedback": { "message": "破折号使用错误" }
    },
    {
      "id": "line-length",
      "scope": "content",
      "conditions": [
        { "target": "originalLineCount", "pattern": "^3$", "match": false },
        { "target": "maxLineLength", "pattern": "^(?:3[89]|[4-9][0-9]|[0-9]{3,})$" }
      ],
      "feedback": { "message": "译文单行加权长度超过 37", "tags": ["length"] }
    },
    {
      "id": "three-line-length",
      "scope": "content",
      "conditions": [
        { "target": "originalLineCount", "pattern": "^3$" },
        { "target": "maxLineLength", "pattern": "^(?:4[6-9]|[5-9][0-9]|[0-9]{3,})$" }
      ],
      "feedback": { "message": "译文单行加权长度超过 45", "tags": ["length"] }
    }
  ]
}
